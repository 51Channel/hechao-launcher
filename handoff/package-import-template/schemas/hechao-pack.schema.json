{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launcher.hechao.world/schemas/hechao-pack-v1.json",
  "title": "Hechao package import descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "minecraftVersion",
    "javaMajorVersion",
    "loader",
    "loaderVersion",
    "clientRoot",
    "serverRoot",
    "sharedRoot"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "minecraftVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "javaMajorVersion": { "type": "integer", "minimum": 8, "maximum": 30 },
    "loader": {
      "enum": ["Vanilla", "Paper", "NeoForge", "Fabric", "Forge"]
    },
    "loaderVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "clientRoot": { "const": "client" },
    "serverRoot": { "const": "server" },
    "sharedRoot": { "const": "shared" }
  }
}
