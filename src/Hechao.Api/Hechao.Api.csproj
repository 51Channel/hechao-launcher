<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hechao.Contracts\Hechao.Contracts.csproj" />
    <ProjectReference Include="..\Hechao.Distribution\Hechao.Distribution.csproj" />
    <ProjectReference Include="..\Hechao.Modpack\Hechao.Modpack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AlibabaCloud.OSS.V2" Version="0.2.0" />
    <PackageReference Include="Norgerman.Cryptography.Scrypt" Version="2.5.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\Migrations\*.sql" />
    <EmbeddedResource Include="Distribution\distribution-trust.json" />
    <Content Remove="Distribution\distribution-trust.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hechao.Api</AssemblyName>
    <RootNamespace>Hechao.Api</RootNamespace>
    <Product>赫朝启动器 API</Product>
    <Version>0.28.0</Version>
    <AdminWebRoot>$(MSBuildProjectDirectory)/AdminWeb</AdminWebRoot>
    <AdminWebOutput>$(MSBuildProjectDirectory)/wwwroot/admin</AdminWebOutput>
    <AdminWebBuildStamp>$(AdminWebRoot)/node_modules/.cache/admin-web-build.stamp</AdminWebBuildStamp>
    <DefaultItemExcludes>$(DefaultItemExcludes);AdminWeb/node_modules/**;AdminWeb/test-results/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="AdminWeb/**/*" />
    <None Remove="AdminWeb/**/*" />
    <AdminWebSource Include="$(AdminWebRoot)/index.html;
                             $(AdminWebRoot)/package.json;
                             $(AdminWebRoot)/package-lock.json;
                             $(AdminWebRoot)/vite.config.ts;
                             $(AdminWebRoot)/tsconfig*.json;
                             $(AdminWebRoot)/scripts/**/*;
                             $(AdminWebRoot)/src/**/*;
                             $(AdminWebRoot)/tests/**/*.test.ts;
                             $(AdminWebRoot)/tests/setup.ts" />
  </ItemGroup>

  <Target Name="InstallAdminWebDependencies"
          Condition="'$(SkipAdminWebBuild)' != 'true'"
          Inputs="$(AdminWebRoot)/package.json;$(AdminWebRoot)/package-lock.json"
          Outputs="$(AdminWebRoot)/node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(AdminWebRoot)" Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="BuildAdminWeb"
          BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
          DependsOnTargets="InstallAdminWebDependencies"
          Condition="'$(SkipAdminWebBuild)' != 'true'"
          Inputs="@(AdminWebSource)"
          Outputs="$(AdminWebBuildStamp);$(AdminWebOutput)/index.html">
    <Exec WorkingDirectory="$(AdminWebRoot)" Command="npm run build" />
    <MakeDir Directories="$(AdminWebRoot)/node_modules/.cache" />
    <Touch Files="$(AdminWebBuildStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <Content Remove="wwwroot/admin/**/*;$(AdminWebOutput)/**/*" />
      <Content Include="wwwroot/admin/**/*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
