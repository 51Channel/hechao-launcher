<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hechao.Launcher.Core</AssemblyName>
    <RootNamespace>Hechao.Launcher</RootNamespace>
    <Version>0.15.8</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hechao.Contracts\Hechao.Contracts.csproj" />
    <ProjectReference Include="..\Hechao.Distribution\Hechao.Distribution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.86.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="..\Hechao.Launcher\LauncherProductInfo.cs"
             Link="LauncherProductInfo.cs" />
    <Compile Include="..\Hechao.Launcher\Infrastructure\*.cs"
             Link="Infrastructure\%(Filename)%(Extension)" />
    <Compile Include="..\Hechao.Launcher\Services\*.cs"
             Exclude="..\Hechao.Launcher\Services\LauncherUpdateService.cs"
             Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\Hechao.Launcher\ViewModels\LauncherNavigation.cs"
             Link="ViewModels\LauncherNavigation.cs" />
    <Compile Include="..\Hechao.Launcher\ViewModels\LauncherUiState.cs"
             Link="ViewModels\LauncherUiState.cs" />
    <Compile Include="..\Hechao.Launcher\ViewModels\ServerCatalogPresentation.cs"
             Link="ViewModels\ServerCatalogPresentation.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Hechao.Launcher\Assets\distribution-trust.json"
                      LogicalName="Hechao.Launcher.Assets.distribution-trust.json" />
  </ItemGroup>

</Project>
