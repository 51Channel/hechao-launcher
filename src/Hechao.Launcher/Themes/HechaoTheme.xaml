                        <Border x:Name="WorkspaceTabIndicator"
                                Width="28"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource HechaoRedBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="WorkspaceTabSurface"
                                    Property="Background"
                                    Value="{StaticResource SurfacePressedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="WorkspaceTabSurface"
                                    Property="Background"
                                    Value="{StaticResource HechaoRedSoftBrush}" />
                            <Setter TargetName="WorkspaceTabIndicator"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource HechaoRedDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="WorkspaceTabSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
