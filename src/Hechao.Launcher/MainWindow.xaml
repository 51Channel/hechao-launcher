<Window x:Class="Hechao.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:contracts="clr-namespace:Hechao.Contracts;assembly=Hechao.Contracts"
        xmlns:controls="clr-namespace:Hechao.Launcher.Controls"
        xmlns:converters="clr-namespace:Hechao.Launcher.Converters"
        mc:Ignorable="d"
        Title="赫朝启动器"
        Width="1500"
        Height="860"
        MinWidth="1060"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}"
        Icon="/Hechao.Launcher;component/Assets/hechao-launcher.ico"
        Background="{StaticResource CanvasBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <converters:ServerListMetaTextConverter x:Key="ServerListMetaTextConverter" />
        <Style x:Key="ServerActionMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Width" Value="228" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerActionMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="{StaticResource HechaoRedSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerActionMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeQuickSettingsComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource MemoryComboBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0,0,24,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="#FFC8C8C4"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="168" />
                <ColumnDefinition x:Name="DirectoryColumn" Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Global navigation -->
            <Border Grid.Column="0"
                    Grid.RowSpan="2"
                    Background="{StaticResource RailBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="78" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="18,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                Background="{StaticResource HechaoRedBrush}"
                                CornerRadius="5">
                            <Image Source="/Hechao.Launcher;component/Assets/hechao-launcher-icon.png"
                                   Width="34"
                                   Height="34"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="赫朝启动器"
                                   FontSize="15"
                                   FontWeight="Black"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LauncherVersionText}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="{StaticResource InkFaintBrush}"
                                   Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,16,10,0">
                    <ToggleButton Style="{StaticResource RailNavigationToggleStyle}"
                                  IsChecked="{Binding IsServersPage, Mode=TwoWay}"
                                  Command="{Binding ShowServersCommand}"
                                  ToolTip="服务器大厅"
                                  AutomationProperties.Name="服务器大厅">
                            <StackPanel Orientation="Horizontal" Margin="18,0">
                                <controls:IconParkIcon Kind="Server"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="服务器"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    <ToggleButton Style="{StaticResource RailNavigationToggleStyle}"
                                  IsChecked="{Binding IsDownloadsPage, Mode=TwoWay}"
                                  Command="{Binding ShowDownloadsCommand}"
                                  ToolTip="下载中心"
                                  AutomationProperties.Name="下载中心">
                            <StackPanel Orientation="Horizontal" Margin="18,0">
                                <controls:IconParkIcon Kind="Download"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="下载"
                                           FontSize="12"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    <ToggleButton Style="{StaticResource RailNavigationToggleStyle}"
                                  IsChecked="{Binding IsActivitiesPage, Mode=TwoWay}"
                                  Command="{Binding ShowActivitiesCommand}"
                                  ToolTip="活动日历"
                                  AutomationProperties.Name="活动日历">
                            <StackPanel Orientation="Horizontal" Margin="18,0">
                                <controls:IconParkIcon Kind="Calendar"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="活动"
                                           FontSize="12"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    <ToggleButton Style="{StaticResource RailNavigationToggleStyle}"
                                  IsChecked="{Binding IsAccountPage, Mode=TwoWay}"
                                  Command="{Binding ShowAccountCommand}"
                                  ToolTip="{Binding AccountActionTooltip}"
                                  AutomationProperties.Name="赫朝账户">
                            <StackPanel Orientation="Horizontal" Margin="18,0">
                                <controls:IconParkIcon Kind="User"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="账户"
                                           FontSize="12"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    <ToggleButton Style="{StaticResource RailNavigationToggleStyle}"
                                  IsChecked="{Binding IsSettingsPage, Mode=TwoWay}"
                                  Command="{Binding ShowSettingsPageCommand}"
                                  ToolTip="启动器设置"
                                  AutomationProperties.Name="启动器设置">
                            <StackPanel Orientation="Horizontal" Margin="18,0">
                                <controls:IconParkIcon Kind="SettingTwo"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="设置"
                                           FontSize="12"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="赫朝 Minecraft 社区"
                                   FontSize="11"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="非 Minecraft 官方产品"
                                   FontSize="10"
                                   Foreground="{StaticResource InkFaintBrush}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Server directory -->
            <Border Grid.Column="1"
                    Grid.RowSpan="2"
                    Background="{StaticResource DirectoryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsServersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="106" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="142" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,0,16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="服务器大厅"
                                       FontSize="20"
                                       FontWeight="Black" />
                            <TextBlock Text="{Binding Servers.Count, StringFormat={}{0} 个可选世界}"
                                       FontSize="12"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="刷新服务器状态"
                                    AutomationProperties.Name="刷新服务器状态" />
                        </StackPanel>
                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <controls:LiveRegionBorder x:Name="ServerCatalogStatusLiveRegion"
                                               Grid.Row="1"
                                               Margin="16,0,16,2"
                                               Padding="12,10"
                                               Background="{StaticResource StripBrush}"
                                               BorderBrush="{StaticResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="4"
                                               AutomationProperties.Name="服务器目录状态"
                                               AutomationProperties.ItemStatus="{Binding CatalogStatusMessage}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="{Binding IsCatalogStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CatalogStatusMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    MinWidth="62"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="重试"
                                    Command="{Binding RefreshCommand}"
                                    AutomationProperties.Name="重新加载服务器目录" />
                        </Grid>
                    </controls:LiveRegionBorder>

                    <ListBox Grid.Row="2"
                             Margin="10,10,10,12"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                             IsEnabled="{Binding CanSelectServer}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="服务器目录">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource ServerListItemStyle}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
                                    <Setter Property="AutomationProperties.HelpText"
                                            Value="{Binding Converter={StaticResource ServerListMetaTextConverter}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type contracts:ServerSummary}">
                                <Grid Height="84">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="4"
                                            Background="{StaticResource HechaoRedBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Width="44"
                                            Height="44"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding ShortName}"
                                                   FontSize="17"
                                                   FontWeight="Black"
                                                   Foreground="{StaticResource HechaoRedDarkBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="2,0,4,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static contracts:ServerStatus.Online}">
                                                                <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="12" Foreground="{StaticResource InkMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="未开放" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static contracts:ServerStatus.Online}">
                                                                <Setter Property="Text" Value="在线" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                                <Setter Property="Text" Value="维护中" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource ServerListMetaTextConverter}}"
                                                   ToolTip="{Binding Converter={StaticResource ServerListMetaTextConverter}}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,9,0">
                                        <TextBlock Text="{Binding OnlinePlayers}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   HorizontalAlignment="Right">
                                            <Run Text="/" />
                                            <Run Text="{Binding MaxPlayers}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Margin="16,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="0,18,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="SidebarAccountAvatar"
                                    Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    Background="#FFD1A071"
                                    BorderBrush="#FFB97B4A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Grid Width="40"
                                      Height="40"
                                      ClipToBounds="True"
                                      SnapsToDevicePixels="True"
                                      RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Canvas Width="40" Height="40">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAccountSkin}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="32" Height="27" Fill="#FFB56E3E" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="32" Height="9" Fill="#FF3B2419" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="10" Width="6" Height="10" Fill="#FF3B2419" />
                                        <Rectangle Canvas.Left="30" Canvas.Top="10" Width="6" Height="10" Fill="#FF3B2419" />
                                        <Rectangle Canvas.Left="10" Canvas.Top="16" Width="6" Height="5" Fill="#FFF8F2EA" />
                                        <Rectangle Canvas.Left="24" Canvas.Top="16" Width="6" Height="5" Fill="#FFF8F2EA" />
                                        <Rectangle Canvas.Left="12" Canvas.Top="17" Width="3" Height="3" Fill="#FF2C1A15" />
                                        <Rectangle Canvas.Left="25" Canvas.Top="17" Width="3" Height="3" Fill="#FF2C1A15" />
                                        <Rectangle Canvas.Left="8" Canvas.Top="30" Width="24" Height="10" Fill="#FF263C2D" />
                                    </Canvas>
                                    <Grid Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                            Viewbox="8,8,8,8"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"
                                                            TileMode="None" />
                                            </Border.Background>
                                        </Border>
                                        <Border>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                            Viewbox="40,8,8,8"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"
                                                            TileMode="None" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="5,0,5,0">
                                <TextBlock Text="{Binding AccountDisplayName}"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding AccountStatusText}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AccountAccessText}"
                                           FontSize="11"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource QuietIconButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    Content="{Binding AccountActionGlyph}"
                                    Command="{Binding AccountActionCommand}"
                                    ToolTip="{Binding AccountActionTooltip}"
                                    AutomationProperties.Name="{Binding AccountActionTooltip}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Column="2"
                  Grid.Row="0"
                  Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                  Visibility="{Binding IsServersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="28,0,0,0">
                    <TextBlock Text="服务器"
                               FontSize="14"
                               Foreground="{StaticResource InkMutedBrush}"
                               VerticalAlignment="Center" />
                    <controls:IconParkIcon Kind="Right"
                                           Width="10"
                                           Height="10"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           Margin="11,0"
                                           VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedServer.Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="46" Height="64">
                        <ToggleButton Style="{StaticResource QuietIconToggleButtonStyle}"
                                      Width="38"
                                      Height="38"
                                      Content="&#xE7F4;"
                                      IsChecked="{Binding IsNotificationsOpen, Mode=TwoWay}"
                                      ToolTip="通知中心"
                                      AutomationProperties.Name="通知中心"
                                      VerticalAlignment="Center" />
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource HechaoRedBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,17,7,0"
                                 IsHitTestVisible="False" />
                    </Grid>
                    <Button Style="{StaticResource QuietIconButtonStyle}"
                            Width="46"
                            Height="64"
                            Content="&#xE713;"
                            Command="{Binding ShowSettingsPageCommand}"
                            ToolTip="启动器设置"
                            AutomationProperties.Name="启动器设置" />
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource BorderBrush}"
                            Margin="4,0,6,0"
                            VerticalAlignment="Center" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Height="64"
                                Content="&#xE921;"
                                Click="MinimizeButton_OnClick"
                                ToolTip="最小化"
                                AutomationProperties.Name="最小化窗口" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Height="64"
                                Content="&#xE922;"
                                Click="MaximizeButton_OnClick"
                                ToolTip="最大化或还原"
                                AutomationProperties.Name="最大化或还原窗口" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Height="64"
                                Content="&#xE8BB;"
                                Click="CloseButton_OnClick"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭启动器" />
                </StackPanel>

                <Border Grid.ColumnSpan="2"
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        VerticalAlignment="Bottom" />
            </Grid>

            <!-- Server workspace -->
            <Grid Grid.Column="2"
                  Grid.Row="1"
                  Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding IsServersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="47*" />
                    <ColumnDefinition Width="53*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Margin="20,18,10,14"
                      ClipToBounds="True">
                    <Image Source="/Hechao.Launcher;component/Assets/hechao-fortress-banner.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="22,16,0,0">
                        <Border Padding="12,7"
                                Background="#F5FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Online}">
                                                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Closed}">
                                                    <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SelectedServerStatusText}"
                                           FontSize="13"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,7"
                                Margin="7,0,0,0"
                                Background="#F5FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Text="{Binding SelectedServerCategoryText}"
                                       FontSize="13"
                                       Foreground="{StaticResource HechaoRedDarkBrush}"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Grid.RowSpan="1"
                        Margin="10,18,20,14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid Margin="26,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="72" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedServer.Name}"
                                       FontSize="27"
                                       FontWeight="Black" />
                            <Border Padding="9,4"
                                    Margin="12,1,0,0"
                                    Background="{StaticResource HechaoRedSoftBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedServerStatusText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HechaoRedDarkBrush}" />
                            </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedServerDescriptionText}"
                                       FontSize="13"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,6,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <controls:IconParkIcon Kind="Box"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{StaticResource SteelBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedServerVersionText}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="13,0" />
                                <controls:IconParkIcon Kind="User"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{StaticResource SteelBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedServerAccessText}"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="13,0" />
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Online}">
                                                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                             Value="{x:Static contracts:ServerStatus.Closed}">
                                                    <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SelectedServerPlayerText}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding HasSelectedServerSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="1"
                                            Height="12"
                                            Background="{StaticResource BorderBrush}"
                                            Margin="13,0" />
                                    <controls:IconParkIcon Kind="Calendar"
                                                           Width="12"
                                                           Height="12"
                                                           Foreground="{StaticResource SteelBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SelectedServerScheduleText}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Height="54"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PrimaryActionCommand}"
                                    AutomationProperties.Name="{Binding PrimaryActionText}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Glyph="{Binding PrimaryActionGlyph}"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="White"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PrimaryActionText}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ServerActionsButton"
                                    Grid.Column="2"
                                    Width="54"
                                    Height="54"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Click="ServerActionsButton_OnClick"
                                    ToolTip="客户端操作"
                                    AutomationProperties.Name="打开客户端操作菜单">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ServerActionsContextMenu"
                                                 Style="{StaticResource ServerActionMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Placement="Bottom">
                                        <MenuItem Header="回滚客户端"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  IsEnabled="{Binding CanRollbackSelectedProfile}"
                                                  ToolTip="{Binding RollbackProfileToolTip}"
                                                  Click="RollbackProfileButton_OnClick"
                                                  AutomationProperties.Name="回滚客户端">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="History" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="校验并修复客户端"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  Command="{Binding RepairCommand}"
                                                  AutomationProperties.Name="校验并修复客户端">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="Repair" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除客户端"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  IsEnabled="{Binding CanDeleteSelectedProfile}"
                                                  ToolTip="{Binding DeleteProfileToolTip}"
                                                  Click="DeleteProfileButton_OnClick"
                                                  AutomationProperties.Name="删除客户端">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="Delete" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="客户端设置"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  Command="{Binding ShowSettingsPageCommand}"
                                                  AutomationProperties.Name="打开客户端设置">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="SettingTwo" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource ServerActionMenuSeparatorStyle}" />
                                        <MenuItem Header="Java 自动"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  Command="{Binding UseManagedJavaCommand}"
                                                  AutomationProperties.Name="使用客户端自带 Java">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="Code" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Java 自定义"
                                                  Style="{StaticResource ServerActionMenuItemStyle}"
                                                  Click="ChooseProfileJavaButton_OnClick"
                                                  AutomationProperties.Name="选择自定义 Java">
                                            <MenuItem.Icon>
                                                <controls:IconParkIcon Kind="FolderOpen" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <controls:IconParkIcon Kind="More"
                                                       Width="18"
                                                       Height="18" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="20,0,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfacePanelStyle}">
                        <Grid Margin="22,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Announcement"
                                                           Width="17"
                                                           Height="17"
                                                           Foreground="{StaticResource HechaoRedBrush}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Text="公告"
                                               FontSize="16"
                                               FontWeight="Black"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right"
                                              Style="{StaticResource QuietIconToggleButtonStyle}"
                                              Width="34"
                                              Height="34"
                                              Content="&#xE8A7;"
                                              IsChecked="{Binding IsNotificationsOpen, Mode=TwoWay}"
                                              ToolTip="打开通知中心"
                                              AutomationProperties.Name="打开通知中心" />
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding HomeAnnouncementServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type contracts:ServerSummary}">
                                        <Grid Height="31">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5"
                                                     Height="5"
                                                     Fill="{StaticResource HechaoRedBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Announcement}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Announcement}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasNoHomeAnnouncements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="暂无服务器公告"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfacePanelStyle}">
                        <Grid Margin="22,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Calendar"
                                                           Width="17"
                                                           Height="17"
                                                           Foreground="{StaticResource HechaoRedBrush}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Text="近期活动"
                                               FontSize="16"
                                               FontWeight="Black"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Height="32"
                                        Padding="10,4"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding ShowActivitiesCommand}"
                                        Content="查看活动"
                                        AutomationProperties.Name="查看全部活动" />
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ActivityCalendar.UpcomingActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="31">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*" />
                                                <ColumnDefinition Width="55*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Padding="6,2"
                                                        Background="{StaticResource HechaoRedSoftBrush}"
                                                        CornerRadius="3">
                                                    <TextBlock Text="活动"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource HechaoRedDarkBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="9,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ScheduleText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="12,0,0,0"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ScheduleText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ActivityCalendar.HasNoUpcomingActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="近期暂无已排期活动"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="HomeQuickSettingsPanel"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="20,0,20,14"
                        Style="{StaticResource SurfacePanelStyle}">
                    <Grid x:Name="HomeQuickSettingsGrid" Margin="22,13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="SettingTwo"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="{StaticResource HechaoRedBrush}"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="快捷设置"
                                           FontSize="15"
                                           FontWeight="Black"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedProfileDisplayName}"
                                       FontSize="11"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedProfileDisplayName}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        Background="{StaticResource SteelSoftBrush}"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <controls:IconParkIcon Kind="Code"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{StaticResource SteelBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Java"
                                               FontSize="10"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedProfileJavaVersionText}"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Style="{StaticResource QuietIconButtonStyle}"
                                        ContentTemplate="{x:Null}"
                                        Click="ChooseProfileJavaButton_OnClick"
                                        ToolTip="更改当前档案 Java"
                                        AutomationProperties.Name="更改当前档案 Java">
                                    <controls:IconParkIcon Kind="Down" Width="11" Height="11" />
                                </Button>
                            </Grid>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Height="36"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />

                            <Grid Grid.Column="2" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        Background="{StaticResource SteelSoftBrush}"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <controls:IconParkIcon Kind="Box"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{StaticResource SteelBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="运行内存"
                                               FontSize="10"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <ComboBox x:Name="HomeMemorySelector"
                                              Style="{StaticResource HomeQuickSettingsComboBoxStyle}"
                                              Margin="-1,-1,0,-4"
                                              ItemsSource="{Binding MemoryOptions}"
                                              SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="调整当前客户端游戏内存"
                                              AutomationProperties.Name="当前客户端游戏内存" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="3"
                                    Width="1"
                                    Height="36"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />

                            <Grid Grid.Column="4" Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        Background="{StaticResource SteelSoftBrush}"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <controls:IconParkIcon Kind="Folder"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{StaticResource SteelBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="当前 .minecraft"
                                               FontSize="10"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <TextBlock x:Name="HomeClientDirectoryText"
                                               Text="{Binding SelectedProfileGameDirectoryDisplayText}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedProfileGameDirectoryDisplayText}"
                                               AutomationProperties.HelpText="{Binding SelectedProfileGameDirectoryDisplayText}"
                                               Margin="0,2,8,0" />
                                </StackPanel>
                                <Button x:Name="OpenHomeProfileDirectoryButton"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Style="{StaticResource QuietIconButtonStyle}"
                                        ContentTemplate="{x:Null}"
                                        Command="{Binding OpenSelectedProfileGameDirectoryCommand}"
                                        ToolTip="打开当前档案游戏目录"
                                        AutomationProperties.Name="打开当前档案游戏目录">
                                    <controls:IconParkIcon Kind="FolderOpen" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

            <!-- Shared title bar for non-server pages -->
            <Grid Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="0"
                  Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                  Panel.ZIndex="5">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsServersPage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="26,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource HechaoRedBrush}"
                            CornerRadius="4">
                        <Image Source="/Hechao.Launcher;component/Assets/hechao-launcher-icon.png"
                               Width="24"
                               Height="24"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="赫朝"
                               FontSize="14"
                               FontWeight="Black"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <controls:IconParkIcon Kind="Right"
                                           Width="10"
                                           Height="10"
                                           Foreground="{StaticResource InkFaintBrush}"
                                           Margin="12,0"
                                           VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton Style="{StaticResource QuietIconToggleButtonStyle}"
                                  Width="46"
                                  Height="64"
                                  Content="&#xE7F4;"
                                  IsChecked="{Binding IsNotificationsOpen, Mode=TwoWay}"
                                  ToolTip="通知中心"
                                  AutomationProperties.Name="通知中心" />
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource BorderBrush}"
                            Margin="4,0,6,0"
                            VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Height="64"
                            Content="&#xE921;"
                            Click="MinimizeButton_OnClick"
                            ToolTip="最小化"
                            AutomationProperties.Name="最小化窗口" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Height="64"
                            Content="&#xE922;"
                            Click="MaximizeButton_OnClick"
                            ToolTip="最大化或还原"
                            AutomationProperties.Name="最大化或还原窗口" />
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Height="64"
                            Content="&#xE8BB;"
                            Click="CloseButton_OnClick"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭启动器" />
                </StackPanel>
                <Border Grid.ColumnSpan="2"
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        VerticalAlignment="Bottom" />
            </Grid>

            <!-- Downloads page -->
            <Grid Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding IsDownloadsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="34,28,34,34" MaxWidth="1260">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CONTENT DELIVERY"
                                           Style="{StaticResource PageEyebrowStyle}" />
                                <TextBlock Text="下载中心"
                                           Style="{StaticResource PageHeaderTitleStyle}"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding DownloadQueueStatusText}"
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding OpenClientDirectoryCommand}"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="打开游戏数据目录">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Kind="FolderOpen"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0" />
                                        <TextBlock Text="打开游戏数据目录" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding ClearDownloadHistoryCommand}"
                                        AutomationProperties.Name="清空下载历史">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Kind="Delete"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0" />
                                        <TextBlock Text="清空历史" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource SurfacePanelStyle}"
                                Margin="0,26,0,0"
                                Padding="24">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveDownload}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        Background="{StaticResource HechaoRedSoftBrush}"
                                        CornerRadius="4"
                                        VerticalAlignment="Top">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{StaticResource HechaoRedDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Column="1" Margin="10,0,24,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding ActiveDownload.DisplayName}"
                                                   FontSize="17"
                                                   FontWeight="Black" />
                                        <TextBlock Text="{Binding ActiveDownload.ProgressText}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ActiveDownload.CurrentFile}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,7,0,0" />
                                <controls:AnimatedProgressBar Grid.Row="2"
                                                              Style="{StaticResource HechaoProgressBarStyle}"
                                                              Value="{Binding ActiveDownload.Percent, Mode=OneWay}"
                                                              Maximum="100"
                                                              Margin="0,12,0,0"
                                                              AutomationProperties.Name="当前下载进度" />
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding ActiveDownload.Version, StringFormat=客户端版本 {0}}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{StaticResource InkFaintBrush}"
                                               Margin="0,8,0,0" />
                                </Grid>
                                <Button Grid.Column="2"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding CancelDownloadCommand}"
                                        VerticalAlignment="Center"
                                        Content="取消任务"
                                        AutomationProperties.Name="取消当前下载" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,26,0,0"
                                Padding="24"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoActiveDownload}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="Download"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{StaticResource InkFaintBrush}"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="当前没有正在进行的任务"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                    <TextBlock Text="从服务器页安装或修复客户端后，实时速度、文件和校验进度会显示在这里。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,28,0,12">
                            <TextBlock Text="下载历史"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DownloadHistoryCount, StringFormat={}{0} 条记录}"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding DownloadHistory}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AutomationProperties.Name="下载历史">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource PageListItemStyle}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding ProgressText}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SurfacePanelStyle}"
                                                Padding="20,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        Background="{StaticResource SteelSoftBrush}"
                                                        CornerRadius="4">
                                                    <controls:IconParkIcon Kind="Download"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Foreground="{StaticResource SteelBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding FailureMessage}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource InkMutedBrush}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Version, StringFormat=版本 {0}}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="11"
                                                               Foreground="{StaticResource InkFaintBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource HechaoRedDarkBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="11"
                                                               Foreground="{StaticResource InkFaintBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Padding="26"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoDownloadHistory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="完成过的安装、更新、修复和中断任务都会保存在这里。"
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Activities page -->
            <Grid Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding IsActivitiesPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Resources>
                    <Style x:Key="ActivityCalendarDayButtonStyle" TargetType="Button">
                        <Setter Property="MinHeight" Value="88" />
                        <Setter Property="Padding" Value="8,7" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Border x:Name="DaySurface"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,1" />
                                        <ContentPresenter x:Name="DayContent"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        <Border x:Name="DaySelection"
                                                Margin="2"
                                                BorderBrush="{StaticResource HechaoRedBrush}"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource StripBrush}" />
                                            <Setter TargetName="DayContent" Property="Opacity" Value="0.62" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource HechaoRedSoftBrush}" />
                                            <Setter TargetName="DayContent" Property="Opacity" Value="1" />
                                            <Setter TargetName="DaySelection" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ActivityStatusDotStyle" TargetType="Ellipse">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Height" Value="6" />
                        <Setter Property="Fill" Value="{StaticResource ClosedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Online}">
                                <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ActivityStatusTextStyle" TargetType="TextBlock">
                        <Setter Property="Text" Value="未开放" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Online}">
                                <Setter Property="Text" Value="开放中" />
                                <Setter Property="Foreground" Value="{StaticResource OnlineBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                <Setter Property="Text" Value="维护中" />
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ActivityCalendarDetailItemStyle" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Server.Name}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ScheduleText}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding AnnouncementText}" />
                    </Style>

                    <DataTemplate x:Key="ActivityCalendarDetailTemplate">
                        <Border Padding="18,16"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource ActivityStatusDotStyle}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Server.Name}"
                                               FontSize="14"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                    <TextBlock Grid.Column="2"
                                               Margin="10,1,0,0"
                                               Style="{StaticResource ActivityStatusTextStyle}"
                                               VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ScheduleText}"
                                           Margin="14,8,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HechaoRedDarkBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AnnouncementText}"
                                           Margin="14,6,0,0"
                                           FontSize="11"
                                           LineHeight="17"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <Grid Grid.Row="3" Margin="14,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{StaticResource InkFaintBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Server.MinecraftVersion}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Server.Loader}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{StaticResource InkFaintBrush}"
                                               Margin="10,0,0,0">
                                        <Run Text="{Binding Server.OnlinePlayers}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding Server.MaxPlayers}" />
                                        <Run Text=" 在线" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Row="4"
                                           Text="{Binding ClientStateText}"
                                           Margin="14,10,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkMutedBrush}" />
                                <Button Grid.Row="5"
                                         Height="38"
                                         Margin="14,13,0,0"
                                         Style="{StaticResource BaseButtonStyle}"
                                         Command="{Binding DataContext.PrepareActivityClientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         IsEnabled="{Binding CanPrepareClient}"
                                         CommandParameter="{Binding}"
                                         ToolTip="{Binding ClientActionHint}"
                                         AutomationProperties.Name="{Binding ClientActionAutomationName}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Kind="{Binding ClientActionIcon}"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ClientActionText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="30,24,30,30" MaxWidth="1320">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="活动日历"
                                           Style="{StaticResource PageHeaderTitleStyle}" />
                                <TextBlock Text="按日期查看活动开放时间；未开放时也可以提前准备对应客户端。"
                                           Margin="0,7,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="刷新活动状态">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Refresh"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,8,0" />
                                    <TextBlock Text="刷新状态" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <controls:LiveRegionBorder x:Name="ActivityCalendarStatusLiveRegion"
                                                   Grid.Row="1"
                                                   Margin="0,18,0,0"
                                                   Padding="14,11"
                                                   Background="{StaticResource StripBrush}"
                                                   BorderBrush="{StaticResource BorderBrush}"
                                                   BorderThickness="1"
                                                   CornerRadius="4"
                                                   AutomationProperties.Name="活动日历状态"
                                                   AutomationProperties.ItemStatus="{Binding ActivityCalendarStatusMessage}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Visibility="{Binding IsActivityCalendarStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="Calendar"
                                                       Width="18"
                                                       Height="18"
                                                       Margin="0,1,11,0"
                                                       Foreground="{StaticResource HechaoRedDarkBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ActivityCalendarStatusTitle}"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding ActivityCalendarStatusMessage}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="94"
                                        Height="34"
                                        Margin="16,0,0,0"
                                        Padding="12,5"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Content="重新加载"
                                        Command="{Binding RefreshCommand}"
                                        AutomationProperties.Name="重新加载活动日历" />
                            </Grid>
                        </controls:LiveRegionBorder>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SurfacePanelStyle}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="16,12"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActivityCalendar.DisplayedMonthText}"
                                                           FontSize="17"
                                                           FontWeight="Black" />
                                                <TextBlock Text="{Binding ActivityCalendar.MonthSummaryText}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource InkMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Width="34"
                                                        Height="34"
                                                        MinHeight="34"
                                                        Padding="0"
                                                        Style="{StaticResource BaseButtonStyle}"
                                                        Command="{Binding ActivityCalendar.PreviousMonthCommand}"
                                                        ToolTip="上个月"
                                                        AutomationProperties.Name="查看上个月">
                                                    <controls:IconParkIcon Kind="Left"
                                                                           Width="14"
                                                                           Height="14" />
                                                </Button>
                                                <Button Height="34"
                                                        MinHeight="34"
                                                        Margin="6,0"
                                                        Padding="10,5"
                                                        Style="{StaticResource BaseButtonStyle}"
                                                        Command="{Binding ActivityCalendar.GoToTodayCommand}"
                                                        AutomationProperties.Name="回到今天">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:IconParkIcon Kind="Calendar"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Margin="0,0,6,0" />
                                                        <TextBlock Text="今天" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="34"
                                                        Height="34"
                                                        MinHeight="34"
                                                        Padding="0"
                                                        Style="{StaticResource BaseButtonStyle}"
                                                        Command="{Binding ActivityCalendar.NextMonthCommand}"
                                                        ToolTip="下个月"
                                                        AutomationProperties.Name="查看下个月">
                                                    <controls:IconParkIcon Kind="Right"
                                                                           Width="14"
                                                                           Height="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Background="{StaticResource StripBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,9">
                                        <UniformGrid Columns="7">
                                            <TextBlock Text="周一" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周二" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周三" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周四" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周五" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周六" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                            <TextBlock Text="周日" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Center" />
                                        </UniformGrid>
                                    </Border>

                                    <ItemsControl x:Name="ActivityCalendarDays"
                                                  Grid.Row="2"
                                                  ItemsSource="{Binding ActivityCalendar.Days}"
                                                  AutomationProperties.Name="活动月历日期">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ActivityCalendarDayButtonStyle}"
                                                        Command="{Binding DataContext.ActivityCalendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding AutomationName}"
                                                        AutomationProperties.Name="{Binding AutomationName}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border Width="26"
                                                                Height="26"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="13">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource HechaoRedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DayNumber}"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <ItemsControl Grid.Row="1"
                                                                      Margin="0,5,0,0"
                                                                      ItemsSource="{Binding VisibleActivities}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Height="23"
                                                                            Margin="0,0,0,3"
                                                                            Padding="6,0"
                                                                            Background="{StaticResource SurfaceMutedBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Ellipse Style="{StaticResource ActivityStatusDotStyle}"
                                                                                     Margin="0,0,5,0"
                                                                                     VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Server.Name}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding HiddenActivityText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource HechaoRedDarkBrush}"
                                                                   Visibility="{Binding HasHiddenActivities, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    MinHeight="460"
                                    Style="{StaticResource SurfacePanelStyle}"
                                    VerticalAlignment="Top"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="18,16"
                                            Background="{StaticResource StripBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ActivityCalendar.SelectedDateText}"
                                                       FontSize="16"
                                                       FontWeight="Black" />
                                            <TextBlock Text="{Binding ActivityCalendar.SelectedDateSummaryText}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="1" MinHeight="250">
                                        <ListBox x:Name="SelectedActivityList"
                                                 ItemsSource="{Binding ActivityCalendar.SelectedActivities}"
                                                 ItemTemplate="{StaticResource ActivityCalendarDetailTemplate}"
                                                 ItemContainerStyle="{StaticResource ActivityCalendarDetailItemStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 IsEnabled="{Binding CanSelectServer}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="所选日期的活动" />
                                        <StackPanel Margin="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="250"
                                                    Visibility="{Binding ActivityCalendar.HasNoSelectedActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <controls:IconParkIcon Kind="Calendar"
                                                                   Width="24"
                                                                   Height="24"
                                                                   Foreground="{StaticResource HechaoRedDarkBrush}"
                                                                   HorizontalAlignment="Center" />
                                            <TextBlock Text="当天暂无活动"
                                                       Margin="0,12,0,0"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="选择带有活动标记的日期，查看开放时间和客户端准备入口。"
                                                       Margin="0,6,0,0"
                                                       FontSize="11"
                                                       LineHeight="17"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="18,15,18,8"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding ActivityCalendar.HasUnscheduledActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="待排期"
                                                       FontSize="13"
                                                       FontWeight="Black" />
                                            <TextBlock Text="这些活动已经提供客户端档案，开放时间仍待公告。"
                                                       Margin="0,4,0,9"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None" />
                                            <ListBox x:Name="UnscheduledActivityList"
                                                     MaxHeight="280"
                                                     ItemsSource="{Binding ActivityCalendar.UnscheduledActivities}"
                                                     ItemTemplate="{StaticResource ActivityCalendarDetailTemplate}"
                                                     ItemContainerStyle="{StaticResource ActivityCalendarDetailItemStyle}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     IsEnabled="{Binding CanSelectServer}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="待排期活动" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Hechao account page -->
            <Grid Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding IsAccountPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="34,28,34,34" MaxWidth="1180">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="IDENTITY &amp; ACCESS"
                                       Style="{StaticResource PageEyebrowStyle}" />
                            <TextBlock Text="赫朝账户"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="赫朝账号负责社区身份与权限，Microsoft 正版身份只用于验证 Minecraft Java 版所有权。"
                                       FontSize="13"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,7,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,26,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44*" />
                                <ColumnDefinition Width="56*" />
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,0,12,0"
                                    Style="{StaticResource SurfacePanelStyle}"
                                    Padding="26">
                                <StackPanel>
                                    <TextBlock Text="登录顺序"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="先建立赫朝身份，再绑定正版游戏身份。两者职责分开，改绑和权限同步更清楚。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,8,0,24" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34"
                                                Height="34"
                                                Background="{StaticResource HechaoRedBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="1"
                                                       FontFamily="Segoe UI"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="赫朝账号"
                                                       FontSize="15"
                                                       FontWeight="Black" />
                                            <TextBlock Text="社区昵称、等级、活动资格和管理权限都归属于这个账号。"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Width="1"
                                            Height="34"
                                            Margin="16,6,0,6"
                                            Background="{StaticResource BorderStrongBrush}"
                                            HorizontalAlignment="Left" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34"
                                                Height="34"
                                                Background="{StaticResource SteelSoftBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="2"
                                                       FontFamily="Segoe UI"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SteelBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Microsoft / Minecraft"
                                                       FontSize="15"
                                                       FontWeight="Black" />
                                            <TextBlock Text="验证账号拥有 Minecraft Java 版。完成后才可由启动器进入服务器。"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,28,0,0"
                                            Padding="16"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconParkIcon Kind="ExternalTransmission"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Foreground="{StaticResource SteelBrush}"
                                                                   Margin="0,0,12,0" />
                                            <TextBlock Text="启动器不会要求你在赫朝账号中填写 Microsoft 密码。"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SurfacePanelStyle}"
                                    Padding="26">
                                <StackPanel>
                                <TabControl Style="{StaticResource AccountTabControlStyle}">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem"
                                               BasedOn="{StaticResource AccountTabStyle}" />
                                    </TabControl.Resources>
                                    <TabItem Header="登录">
                                        <Grid Margin="0,24,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="账号名或邮箱"
                                                       Style="{StaticResource FormLabelStyle}" />
                                            <TextBox x:Name="LoginIdentifierTextBox"
                                                     Grid.Row="1"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     AutomationProperties.Name="赫朝账号名或邮箱" />
                                            <TextBlock Grid.Row="2"
                                                       Text="密码"
                                                       Style="{StaticResource FormLabelStyle}"
                                                       Margin="0,16,0,6" />
                                            <PasswordBox x:Name="LoginPasswordBox"
                                                         Grid.Row="3"
                                                         Style="{StaticResource PasswordFieldStyle}"
                                                         AutomationProperties.Name="赫朝账号密码" />
                                            <Button Grid.Row="4"
                                                    Height="46"
                                                    Margin="0,22,0,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanSubmitAccountForms}"
                                                    AutomationProperties.Name="登录赫朝账号"
                                                    Click="LoginAccountButton_OnClick">
                                                <TextBlock Text="登录赫朝账号"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="注册">
                                        <Grid Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="账号名"
                                                       Style="{StaticResource FormLabelStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="显示名称"
                                                       Style="{StaticResource FormLabelStyle}"
                                                       Margin="10,0,0,6" />
                                            <TextBox x:Name="RegisterUsernameTextBox"
                                                     Grid.Row="1"
                                                     Margin="0,0,10,0"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     AutomationProperties.Name="赫朝账号名" />
                                            <TextBox x:Name="RegisterDisplayNameTextBox"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="10,0,0,0"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     AutomationProperties.Name="显示名称" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       Text="邮箱"
                                                       Style="{StaticResource FormLabelStyle}"
                                                       Margin="0,16,0,6" />
                                            <Grid Grid.Row="3"
                                                  Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="132" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RegisterEmailTextBox"
                                                         Margin="0,0,10,0"
                                                         Style="{StaticResource TextFieldStyle}"
                                                         AutomationProperties.Name="邮箱" />
                                            <Button x:Name="SendRegistrationCodeButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    IsEnabled="{Binding CanSendRegistrationCode}"
                                                    Click="SendRegistrationCodeButton_OnClick"
                                                    AutomationProperties.Name="{Binding RegistrationCodeActionText}">
                                                <TextBlock Text="{Binding RegistrationCodeActionText}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Row="4"
                                                       Text="邮箱验证码"
                                                       Style="{StaticResource FormLabelStyle}"
                                                       Margin="0,16,10,6" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="密码"
                                                       Style="{StaticResource FormLabelStyle}"
                                                       Margin="10,16,0,6" />
                                            <TextBox x:Name="RegisterCodeTextBox"
                                                     Grid.Row="5"
                                                     MaxLength="6"
                                                     Margin="0,0,10,0"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     AutomationProperties.Name="6 位邮箱验证码" />
                                            <PasswordBox x:Name="RegisterPasswordBox"
                                                         Grid.Row="5"
                                                         Grid.Column="1"
                                                         Margin="10,0,0,0"
                                                         Style="{StaticResource PasswordFieldStyle}"
                                                         AutomationProperties.Name="注册密码" />
                                            <TextBlock Grid.Row="6"
                                                       Grid.ColumnSpan="2"
                                                       Text="账号与 hechao.world 社区共用。密码至少 10 位，并同时包含字母与数字。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkFaintBrush}"
                                                       Margin="0,6,0,0" />
                                            <Button Grid.Row="7"
                                                    Grid.ColumnSpan="2"
                                                    Height="46"
                                                    Margin="0,18,0,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanSubmitAccountForms}"
                                                    AutomationProperties.Name="创建赫朝账号"
                                                    Click="RegisterAccountButton_OnClick">
                                                <TextBlock Text="创建赫朝账号"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                                <controls:LiveRegionBorder x:Name="AccountFormLiveRegion"
                                                           Margin="0,14,0,0"
                                                           AutomationProperties.Name="赫朝账号表单状态"
                                                           AutomationProperties.ItemStatus="{Binding AccountFormMessage}"
                                                           AutomationProperties.LiveSetting="Polite">
                                    <TextBlock Text="{Binding AccountFormMessage}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               TextTrimming="None">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccountFormError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource HechaoRedDarkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </controls:LiveRegionBorder>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,26,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="37*" />
                                <ColumnDefinition Width="63*" />
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,0,12,0"
                                    Style="{StaticResource SurfacePanelStyle}"
                                    Padding="26">
                                <StackPanel>
                                    <Border x:Name="AccountProfileAvatar"
                                            Width="66"
                                            Height="66"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource HechaoRedSoftBrush}"
                                            BorderBrush="#FFD8B2AD"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            AutomationProperties.Name="Minecraft 皮肤头像">
                                        <Grid>
                                            <controls:IconParkIcon Kind="User"
                                                                   Width="28"
                                                                   Height="28"
                                                                   Foreground="{StaticResource HechaoRedDarkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                <controls:IconParkIcon.Style>
                                                    <Style TargetType="controls:IconParkIcon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAccountSkin}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:IconParkIcon.Style>
                                            </controls:IconParkIcon>
                                            <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                                Viewbox="8,8,8,8"
                                                                ViewboxUnits="Absolute"
                                                                Stretch="Fill"
                                                                TileMode="None" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                                Viewbox="40,8,8,8"
                                                                ViewboxUnits="Absolute"
                                                                Stretch="Fill"
                                                                TileMode="None" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontSize="24"
                                               FontWeight="Black"
                                               Margin="0,18,0,0" />
                                    <TextBlock Text="{Binding AccountUsername}"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,4,0,0" />
                                    <Border Height="1"
                                            Background="{StaticResource BorderBrush}"
                                            Margin="0,22,0,18" />
                                    <TextBlock Text="账户状态"
                                               FontSize="11"
                                               Foreground="{StaticResource InkFaintBrush}" />
                                    <TextBlock Text="{Binding AccountStatusText}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding AccountAccessText}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0" />
                                    <Button Margin="0,24,0,0"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding LogoutAccountCommand}"
                                            Content="退出当前设备" />
                                    <Button Margin="0,10,0,0"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding LogoutAllDevicesCommand}"
                                            Content="退出所有设备" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Border Style="{StaticResource SurfacePanelStyle}"
                                        Padding="24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="40"
                                                Background="{StaticResource SteelSoftBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Top">
                                            <controls:IconParkIcon Kind="Shield"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource SteelBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                            <TextBlock Text="Minecraft Java 正版身份"
                                                       FontSize="16"
                                                       FontWeight="Black" />
                                            <TextBlock Text="{Binding MinecraftLinkStatusText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding MinecraftIdentityText}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,9,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Column="2"
                                              MinWidth="176"
                                              VerticalAlignment="Center">
                                            <Button Height="46"
                                                    Command="{Binding LinkMinecraftCommand}"
                                                    AutomationProperties.Name="绑定 Microsoft 正版身份">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMinecraftLinked}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="绑定 Microsoft 正版身份"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="Bold" />
                                            </Button>
                                            <Button Height="46"
                                                    Command="{Binding UnlinkMinecraftCommand}"
                                                    Content="解除 Minecraft 绑定">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BaseButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMinecraftLinked}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="22"
                                        Background="{StaticResource HechaoRedSoftBrush}"
                                        BorderBrush="#FFD8B2AD"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding IsMinecraftUnlinkFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="确认解除 Minecraft 绑定"
                                                   FontSize="15"
                                                   FontWeight="Black" />
                                        <TextBlock Grid.Row="1"
                                                   Text="这会撤销所有设备、管理后台和待使用的进服授权。请输入当前赫朝账号密码确认。"
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Margin="0,7,0,0" />
                                        <Grid Grid.Row="2" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="UnlinkMinecraftPasswordBox"
                                                         Height="42"
                                                         MaxLength="128"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="当前赫朝账号密码"
                                                         AutomationProperties.Name="当前赫朝账号密码" />
                                            <Button Grid.Column="1"
                                                    MinWidth="84"
                                                    Height="42"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    AutomationProperties.Name="取消解除 Minecraft 绑定"
                                                    Click="CancelMinecraftUnlinkButton_OnClick"
                                                    Content="取消" />
                                            <Button Grid.Column="2"
                                                    MinWidth="104"
                                                    Height="42"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    AutomationProperties.Name="确认解除 Minecraft 绑定"
                                                    Click="ConfirmMinecraftUnlinkButton_OnClick">
                                                <TextBlock Text="确认解除"
                                                           Foreground="White"
                                                           FontWeight="Bold" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SurfacePanelStyle}"
                                        Padding="24"
                                        Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="40"
                                                Background="{StaticResource HechaoRedSoftBrush}"
                                                CornerRadius="4">
                                            <controls:IconParkIcon Kind="Lock"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource HechaoRedDarkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                            <TextBlock Text="LuckPerms 权限"
                                                       FontSize="16"
                                                       FontWeight="Black" />
                                            <TextBlock Text="{Binding AccountAccessText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Command="{Binding OpenAdminConsoleCommand}"
                                                Content="{Binding AdminConsoleButtonText}"
                                                VerticalAlignment="Center"
                                                MinWidth="132">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <controls:LiveRegionBorder x:Name="AuthenticatedAccountFormLiveRegion"
                                                           Margin="0,16,0,0"
                                                           Padding="18"
                                                           Background="{StaticResource StripBrush}"
                                                           BorderBrush="{StaticResource BorderBrush}"
                                                           BorderThickness="1"
                                                           CornerRadius="5"
                                                           AutomationProperties.Name="赫朝账户状态"
                                                           AutomationProperties.ItemStatus="{Binding AccountFormMessage}"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Visibility="{Binding HasAccountFormMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AccountFormMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource HechaoRedDarkBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </controls:LiveRegionBorder>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

            </Grid>

            <!-- Settings page -->
            <Grid Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="34,28,34,34" MaxWidth="1180">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="LAUNCHER CONFIGURATION"
                                       Style="{StaticResource PageEyebrowStyle}" />
                            <TextBlock Text="设置"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="所有选项会立即保存，并在对应的下一次安装或启动时生效。"
                                       FontSize="13"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,7,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,24,0,0"
                                Style="{StaticResource SurfacePanelStyle}"
                                Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="游戏与运行"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="适用于所有由赫朝启动器管理的客户端档案。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,28,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="游戏内存"
                                               Style="{StaticResource FormLabelStyle}" />
                                        <ListBox Style="{StaticResource MemorySegmentListStyle}"
                                                 ItemContainerStyle="{StaticResource MemorySegmentItemStyle}"
                                                 ItemsSource="{Binding MemoryOptions}"
                                                 SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="默认游戏内存" />
                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="游戏启动后关闭启动器"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Minecraft 进程成功创建后自动退出启动器。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      IsChecked="{Binding CloseLauncherAfterGameStart, Mode=TwoWay}"
                                                      AutomationProperties.Name="游戏启动后关闭启动器"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Style="{StaticResource SurfacePanelStyle}"
                                Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="客户端与下载"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="目录变更不会移动已有文件，新的安装会写入新位置。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,28,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="游戏数据目录"
                                               Style="{StaticResource FormLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="42"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding ClientDirectory}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ClientDirectory}"
                                                       AutomationProperties.HelpText="{Binding ClientDirectory}" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Margin="10,0,0,0"
                                                Click="ChooseClientDirectoryButton_OnClick"
                                                IsEnabled="{Binding CanChangeClientDirectory}"
                                                Content="更改目录" />
                                    </Grid>

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启动时检查客户端更新"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="进入服务器前比较客户端档案与最新发布清单。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                                      AutomationProperties.Name="启动时检查客户端更新"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                        <Button Margin="0,12,0,0"
                                                Padding="13,8"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding CheckLauncherUpdateCommand}"
                                                AutomationProperties.Name="检查启动器更新">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconParkIcon Kind="CheckOne"
                                                                   Width="13"
                                                                   Height="13"
                                                                   Margin="0,0,7,0" />
                                            <TextBlock Text="立即检查启动器更新" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="保留已下载文件缓存"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="保留校验通过的下载文件，供后续安装、更新或修复复用。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      IsChecked="{Binding KeepDownloadsAfterClose, Mode=TwoWay}"
                                                      AutomationProperties.Name="保留已下载文件缓存"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="安装时打开下载中心"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="开始安装或修复后自动切换到实时下载页面。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      IsChecked="{Binding OpenDownloadsWhenInstalling, Mode=TwoWay}"
                                                      AutomationProperties.Name="安装时打开下载中心"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="使用 Windows 系统代理"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="关闭时直连；切换后下次启动生效。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      IsChecked="{Binding UseSystemProxy, Mode=TwoWay}"
                                                      AutomationProperties.Name="使用 Windows 系统代理"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="0,16,0,0"
                                Style="{StaticResource SurfacePanelStyle}"
                                Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动器行为"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="设置首次打开的工作区，并管理本机启动器数据。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,28,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="默认打开页面"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="下次启动赫朝启动器时首先显示的页面。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource MemoryComboBoxStyle}"
                                                  ItemsSource="{Binding StartupPageOptions}"
                                                  SelectedItem="{Binding SelectedStartupPage, Mode=TwoWay}"
                                                  AutomationProperties.Name="默认打开页面" />
                                    </Grid>
                                    <Border Height="1"
                                            Background="{StaticResource BorderBrush}"
                                            Margin="0,22,0,18" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding OpenClientDirectoryCommand}"
                                                Margin="0,0,8,8"
                                                Content="打开游戏数据目录" />
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding ClearDownloadHistoryCommand}"
                                                Margin="0,0,8,8"
                                                Content="清空下载历史" />
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding ResetLauncherSettingsCommand}"
                                                Margin="0,0,8,8"
                                                Content="恢复默认设置" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                                Margin="0,16,0,0"
                                Style="{StaticResource SurfacePanelStyle}"
                                Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="故障诊断"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="诊断文件只保存在本机，不会自动上传。"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,28,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconParkIcon Kind="History"
                                                               Width="18"
                                                               Height="18"
                                                               Foreground="{StaticResource HechaoRedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="最近一次游戏退出"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LatestGameExitText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="诊断包会脱敏账号标识、令牌、网络地址与本机用户路径，并跳过世界存档。"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="30,16,0,0" />
                                    <TextBlock Text="{Binding DiagnosticUploadStatus}"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="30,8,0,0" />
                                    <WrapPanel Margin="30,18,0,0">
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding CreateDiagnosticBundleCommand}"
                                                Margin="0,0,8,8"
                                                AutomationProperties.Name="生成脱敏诊断包">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconParkIcon Kind="Tool"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DiagnosticActionText}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                IsEnabled="{Binding CanUploadDiagnosticBundle}"
                                                Click="UploadDiagnosticButton_OnClick"
                                                ToolTip="只上传刚刚由启动器生成的脱敏诊断包"
                                                Margin="0,0,8,8"
                                                AutomationProperties.Name="上传脱敏诊断包">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconParkIcon Kind="ExternalTransmission"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DiagnosticUploadActionText}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding OpenDiagnosticsDirectoryCommand}"
                                                Margin="0,0,8,8"
                                                AutomationProperties.Name="打开诊断目录">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconParkIcon Kind="FolderOpen"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Margin="0,0,8,0" />
                                                <TextBlock Text="打开诊断目录"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Notification center -->
            <Border x:Name="NotificationsPanel"
                    Grid.Column="2"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="360"
                    Margin="0,72,12,0"
                    Padding="18"
                    Panel.ZIndex="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    AutomationProperties.Name="通知中心"
                    Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#36000000"
                                      BlurRadius="20"
                                      ShadowDepth="6"
                                      Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="通知中心" FontSize="17" FontWeight="Black" />
                            <TextBlock Text="服务器与客户端动态"
                                       FontSize="12"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="CloseNotificationsButton"
                                HorizontalAlignment="Right"
                                Style="{StaticResource QuietIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Content="&#xE711;"
                                Command="{Binding CloseOverlaysCommand}"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭通知中心" />
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,15,0,0"
                            Padding="0,15,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{StaticResource HechaoRedSoftBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top">
                                <controls:IconParkIcon Kind="VolumeNotice"
                                                       Width="13"
                                                       Height="13"
                                                       Foreground="{StaticResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="活动服开放安排"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="活动服务器会按录制计划开放，开放状态以服务器目录为准。"
                                           FontSize="12"
                                           LineHeight="16"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{StaticResource SteelSoftBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top">
                                <controls:IconParkIcon Kind="CheckOne"
                                                       Width="13"
                                                       Height="13"
                                                       Foreground="{StaticResource SteelBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedProfileDisplayName}"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedProfileMetaText}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Settings drawer -->
            <Border Grid.Column="2"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="420"
                    Panel.ZIndex="22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#30000000"
                                      BlurRadius="22"
                                      ShadowDepth="8"
                                      Direction="180" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="78" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,0,14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动器设置"
                                       FontSize="19"
                                       FontWeight="Black" />
                            <TextBlock Text="客户端、性能与启动行为"
                                       FontSize="12"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource QuietIconButtonStyle}"
                                Width="36"
                                Height="36"
                                Content="&#xE711;"
                                Command="{Binding CloseOverlaysCommand}"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭设置面板" />
                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20">
                            <TextBlock Text="性能"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="56" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="126" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource HechaoRedSoftBrush}"
                                        CornerRadius="4">
                                    <TextBlock Text="RAM"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HechaoRedDarkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="游戏内存" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="下次启动游戏时生效"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource MemoryComboBoxStyle}"
                                          ItemsSource="{Binding MemoryOptions}"
                                          SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="游戏内存" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="存储"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid MinHeight="62" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="Folder"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,2,8,0">
                                    <TextBlock Text="游戏数据目录" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ClientDirectory}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               LineHeight="14"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding ClientDirectory}"
                                               AutomationProperties.HelpText="{Binding ClientDirectory}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource QuietIconButtonStyle}"
                                        Width="36"
                                        Height="36"
                                        Content="&#xE838;"
                                        Command="{Binding OpenClientDirectoryCommand}"
                                        ToolTip="打开游戏数据目录"
                                        AutomationProperties.Name="打开游戏数据目录"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="启动行为"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="50" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="CheckOne"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="启动时检查客户端更新" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="进入服务器前比较客户端档案与最新发布清单。"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                              AutomationProperties.Name="启动时检查客户端更新"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="50" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="保留已下载文件缓存" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="供后续安装、更新或修复复用"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding KeepDownloadsAfterClose, Mode=TwoWay}"
                                              AutomationProperties.Name="保留已下载文件缓存"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="50" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="ExternalTransmission"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="使用 Windows 系统代理" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭时直连；下次启动生效"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding UseSystemProxy, Mode=TwoWay}"
                                              AutomationProperties.Name="使用 Windows 系统代理"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="账号与权限"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="60" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="User"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountAccessText}"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="36"
                                        Command="{Binding AccountActionCommand}"
                                        ToolTip="{Binding AccountActionTooltip}"
                                        AutomationProperties.Name="{Binding AccountActionTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Glyph="{Binding AccountActionGlyph}"
                                                               Width="13"
                                                               Height="13"
                                                               Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding AccountActionTooltip}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        <Button Style="{StaticResource BaseButtonStyle}"
                                Height="38"
                                Margin="42,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenAdminConsoleCommand}"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="在浏览器中打开安全管理后台"
                                AutomationProperties.Name="打开管理后台">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="ExternalTransmission"
                                                           Width="13"
                                                           Height="13"
                                                           Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AdminConsoleButtonText}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource StripBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="24,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LauncherVersionText, StringFormat=赫朝启动器 {0}}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="非 Minecraft 官方产品，与 Mojang 或 Microsoft 无关联。"
                                           FontSize="10"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource OnlineBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="设置自动保存"
                                           FontSize="11"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Global Microsoft authentication -->
            <Border x:Name="MicrosoftSignInOverlay"
                    Grid.ColumnSpan="3"
                    Grid.RowSpan="2"
                    Panel.ZIndex="40"
                    Background="#990F1110"
                    FocusManager.IsFocusScope="True"
                    FocusManager.FocusedElement="{Binding ElementName=CancelMicrosoftSignInButton}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Visibility="{Binding IsMicrosoftSignInVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="520"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource HechaoRedSoftBrush}"
                                    BorderBrush="#FFD8B2AD"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <controls:IconParkIcon Kind="ExternalTransmission"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{StaticResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding MicrosoftSignInTitle}"
                                           FontSize="20"
                                           FontWeight="Black" />
                                <TextBlock Text="MICROSOFT / MINECRAFT"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HechaoRedDarkBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding MicrosoftSignInDescription}"
                                   FontSize="13"
                                   LineHeight="22"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,24,0,0" />

                        <Border Grid.Row="2"
                                Margin="0,22,0,0"
                                Padding="14"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="9"
                                        Height="9"
                                        Margin="1,2,12,0"
                                        VerticalAlignment="Top"
                                        Background="#FF23845B"
                                        CornerRadius="5" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="浏览器窗口已打开"
                                               FontSize="13"
                                               FontWeight="Bold" />
                                    <TextBlock Text="如果没有看到浏览器，取消本次登录后重新点击绑定按钮。"
                                               FontSize="11"
                                               Foreground="{StaticResource InkFaintBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动器不会读取或保存你的 Microsoft 密码。"
                                       FontSize="11"
                                       Foreground="{StaticResource InkFaintBrush}"
                                       VerticalAlignment="Center" />
                        <Button x:Name="CancelMicrosoftSignInButton"
                                Grid.Column="1"
                                MinWidth="126"
                                Height="40"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding CancelMicrosoftSignInCommand}"
                                AutomationProperties.Name="取消 Microsoft 登录">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Close"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,7,0" />
                                    <TextBlock Text="取消本次登录"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Launcher self-update -->
            <Grid x:Name="LauncherUpdateOverlay"
                  Grid.ColumnSpan="3"
                  Grid.RowSpan="2"
                  Panel.ZIndex="50"
                  Background="#990F1110"
                  FocusManager.IsFocusScope="True"
                  FocusManager.FocusedElement="{Binding ElementName=InstallLauncherUpdateButton}"
                  KeyboardNavigation.TabNavigation="Cycle"
                  Visibility="{Binding IsLauncherUpdateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border x:Name="LauncherUpdateDialog"
                        Width="560"
                        MaxHeight="540"
                        Margin="24"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource HechaoRedSoftBrush}"
                                    BorderBrush="#FFD8B2AD"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <controls:IconParkIcon Kind="Download"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{StaticResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding LauncherUpdateTitle}"
                                           FontSize="20"
                                           FontWeight="Black" />
                                <TextBlock Text="{Binding LauncherUpdateSummary}"
                                           Margin="0,5,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Padding="9,5"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource HechaoRedSoftBrush}"
                                    BorderBrush="#FFD8B2AD"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding IsLauncherUpdateRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="必须更新"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HechaoRedDarkBrush}" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,22,0,18"
                                Background="{StaticResource BorderBrush}" />

                        <Border Grid.Row="2"
                                Padding="16,14"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer MaxHeight="116"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding LauncherUpdateReleaseNotes}"
                                               FontSize="13"
                                               LineHeight="21"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding LauncherUpdateSizeText, StringFormat=安装包大小：{0}}"
                                           Margin="0,11,0,0"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </Grid>
                        </Border>

                        <controls:LiveRegionBorder x:Name="LauncherUpdateProgressRegion"
                                                   Grid.Row="3"
                                                   Margin="0,20,0,0"
                                                   Focusable="True"
                                                   AutomationProperties.Name="启动器更新状态"
                                                   AutomationProperties.ItemStatus="{Binding LauncherUpdateStatus}"
                                                   AutomationProperties.LiveSetting="Polite">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:AnimatedProgressBar Grid.Row="0"
                                                              Style="{StaticResource HechaoProgressBarStyle}"
                                                              Maximum="100"
                                                              Value="{Binding LauncherUpdateProgress, Mode=OneWay}"
                                                              AutomationProperties.Name="启动器更新进度" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding LauncherUpdateStatus}"
                                           Margin="0,9,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </Grid>
                        </controls:LiveRegionBorder>

                        <Grid Grid.Row="4"
                              Margin="0,24,0,0"
                              HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Height="44"
                                    MinHeight="44"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="稍后更新"
                                    Command="{Binding DismissLauncherUpdateCommand}" />
                            <Button x:Name="InstallLauncherUpdateButton"
                                    Grid.Column="2"
                                    Height="44"
                                    MinHeight="44"
                                    Padding="18,10"
                                    Foreground="White"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallLauncherUpdateCommand}"
                                    AutomationProperties.Name="下载更新并重启">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="15"
                                                           Height="15"
                                                           Margin="0,0,8,0"
                                                           Foreground="White" />
                                    <TextBlock Text="下载并重启"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Toast -->
            <controls:LiveRegionBorder x:Name="ToastLiveRegion"
                    Grid.Column="2"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Padding="17,10"
                    Panel.ZIndex="30"
                    Background="#F01B1A18"
                    CornerRadius="5"
                    Tag="{Binding ToastSeverity}"
                    AutomationProperties.Name="{Binding ToastMessage}"
                    AutomationProperties.ItemStatus="{Binding ToastAutomationStatus}"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconParkIcon Kind="{Binding ToastIconKind}"
                                           Width="12"
                                           Height="12"
                                           Foreground="#FFFF5A51"
                                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ToastMessage}"
                               Margin="8,0,0,0"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center" />
                </Grid>
            </controls:LiveRegionBorder>
        </Grid>
    </Border>
</Window>
