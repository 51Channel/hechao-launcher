<Window x:Class="Hechao.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:contracts="clr-namespace:Hechao.Contracts;assembly=Hechao.Contracts"
        xmlns:controls="clr-namespace:Hechao.Launcher.Controls"
        xmlns:converters="clr-namespace:Hechao.Launcher.Converters"
        mc:Ignorable="d"
        Title="赫朝启动器"
        Width="1200"
        Height="720"
        MinWidth="1060"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}"
        Icon="/Hechao.Launcher;component/Assets/hechao-launcher.ico"
        Background="{DynamicResource CanvasBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <converters:ServerListMetaTextConverter x:Key="ServerListMetaTextConverter" />
        <converters:ServerIsActivityConverter x:Key="ServerIsActivityConverter" />
        <Style x:Key="ServerActionMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Width" Value="228" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerActionMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource HechaoRedSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerActionMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeQuickSettingsComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource MemoryComboBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0,0,24,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
                    <Style x:Key="ActivityCalendarDayButtonStyle" TargetType="Button">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="8,7" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Border x:Name="DaySurface"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="0,0,0,1" />
                                        <ContentPresenter x:Name="DayContent"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        <Border x:Name="DaySelection"
                                                Margin="2"
                                                BorderBrush="{DynamicResource HechaoRedBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DaySurface"
                                                    Property="Background"
                                                    Value="{DynamicResource SurfaceMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DaySurface"
                                                    Property="Background"
                                                    Value="{DynamicResource SurfacePressedBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter TargetName="DaySurface"
                                                    Property="Background"
                                                    Value="{DynamicResource StripBrush}" />
                                            <Setter TargetName="DayContent" Property="Opacity" Value="0.58" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="DaySurface"
                                                    Property="Background"
                                                    Value="{DynamicResource SurfaceMutedBrush}" />
                                            <Setter TargetName="DayContent" Property="Opacity" Value="1" />
                                            <Setter TargetName="DaySelection" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ActivityStatusDotStyle" TargetType="Ellipse">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Height" Value="6" />
                        <Setter Property="Fill" Value="{DynamicResource ClosedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Online}">
                                <Setter Property="Fill" Value="{DynamicResource OnlineBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ActivityStatusTextStyle" TargetType="TextBlock">
                        <Setter Property="Text" Value="未开放" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Online}">
                                <Setter Property="Text" Value="开放中" />
                                <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Server.Status}"
                                         Value="{x:Static contracts:ServerStatus.Maintenance}">
                                <Setter Property="Text" Value="维护中" />
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ActivityCalendarListStyle" TargetType="ListBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer Focusable="False"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ActivityCalendarDetailItemStyle" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource HechaoFocusVisualStyle}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Server.Name}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ScheduleText}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding AnnouncementText}" />
                    </Style>

                    <DataTemplate x:Key="ActivityCalendarDetailTemplate">
                        <Border x:Name="ActivityDetailItemSurface"
                                Margin="22,0,18,0"
                                Padding="0,18"
                                BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource ActivityStatusDotStyle}"
                                             Margin="0,0,9,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Server.Name}"
                                               FontSize="16"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,2,0,0"
                                               Style="{StaticResource ActivityStatusTextStyle}"
                                               VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ScheduleText}"
                                           Margin="15,8,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AnnouncementText}"
                                           Margin="15,7,0,0"
                                           FontSize="11"
                                           LineHeight="17"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <Grid Grid.Row="3" Margin="15,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}">
                                        <Run Text="{Binding Server.MinecraftVersion}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Server.Loader}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Margin="10,0,0,0">
                                        <Run Text="{Binding Server.OnlinePlayers}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding Server.MaxPlayers}" />
                                        <Run Text=" 在线" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Row="4"
                                           Text="{Binding AccessText}"
                                           Margin="15,10,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5"
                                           Text="{Binding ClientStateText}"
                                           Margin="15,8,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkMutedBrush}" />
                                <Button Grid.Row="6"
                                        Height="42"
                                        Margin="15,15,0,0"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding DataContext.PrepareActivityClientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        IsEnabled="{Binding CanPrepareClient}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding ClientActionHint}"
                                        AutomationProperties.Name="{Binding ClientActionAutomationName}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Kind="{Binding ClientActionIcon}"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ClientActionText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="0" />
                <ColumnDefinition x:Name="DirectoryColumn" Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="420" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Server directory -->
            <Border x:Name="ServerDirectoryPanel"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource DirectoryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsServersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,0,30,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="服务器"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource OnlineBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Servers.Count, StringFormat={}{0} 个可见服务器}"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkFaintBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Height="38"
                                MinHeight="38"
                                Padding="13,0"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="刷新服务器状态"
                                AutomationProperties.Name="刷新服务器状态">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="Refresh"
                                                       Width="15"
                                                       Height="15"
                                                       Margin="0,0,8,0" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <controls:LiveRegionBorder x:Name="ServerCatalogStatusLiveRegion"
                                               Grid.Row="1"
                                               Margin="28,0,30,8"
                                               Padding="12,10"
                                               Background="{DynamicResource StripBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="4"
                                               AutomationProperties.Name="服务器目录状态"
                                               AutomationProperties.ItemStatus="{Binding CatalogStatusMessage}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="{Binding IsCatalogStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CatalogStatusMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    MinWidth="62"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="重试"
                                    Command="{Binding RefreshCommand}"
                                    AutomationProperties.Name="重新加载服务器目录" />
                        </Grid>
                    </controls:LiveRegionBorder>

                    <ListBox Grid.Row="2"
                             Margin="28,8,14,14"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                             IsEnabled="{Binding CanSelectServer}"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="服务器目录">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource ServerCardListItemStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="{Binding Converter={StaticResource ServerListMetaTextConverter}}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type contracts:ServerSummary}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="112" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="ServerCardArtworkSurface"
                                            Grid.Row="0"
                                            CornerRadius="6,6,0,0"
                                            SnapsToDevicePixels="True"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="/Hechao.Launcher;component/Assets/hechao-fortress-banner.png"
                                                                    Stretch="UniformToFill" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Converter={StaticResource ServerIsActivityConverter}}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource SteelSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid x:Name="ActivityServerCardArtwork">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Converter={StaticResource ServerIsActivityConverter}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontSize="88"
                                                           FontWeight="Black"
                                                           Foreground="{DynamicResource SteelBrush}"
                                                           Opacity="0.14"
                                                           Margin="0,-14,24,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Margin="22,0,0,0"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <Border Width="46"
                                                            Height="46"
                                                            Background="{DynamicResource HechaoRedSoftBrush}"
                                                            BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   FontSize="22"
                                                                   FontWeight="Black"
                                                                   Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="13,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="赫朝活动"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource InkBrush}" />
                                                        <TextBlock Text="限时企划"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource InkFaintBrush}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Border x:Name="ServerCardShortNameBadge"
                                                    Margin="10"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Converter={StaticResource ServerIsActivityConverter}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ShortName}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Border>
                                            <Border Margin="10"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未开放" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ClosedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="{x:Static contracts:ServerStatus.Online}">
                                                                    <Setter Property="Text" Value="在线" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                                    <Setter Property="Text" Value="维护中" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="14,11,14,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <controls:IconParkIcon Grid.Column="1"
                                                                   Kind="Right"
                                                                   Width="12"
                                                                   Height="12"
                                                                   Margin="10,0,0,0"
                                                                   Foreground="{DynamicResource InkFaintBrush}"
                                                                   VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Announcement}"
                                                   ToolTip="{Binding Announcement}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource InkFaintBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Minecraft {0} · {1}">
                                                        <Binding Path="MinecraftVersion" />
                                                        <Binding Path="Loader" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource InkFaintBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}">
                                                        <Binding Path="OnlinePlayers" />
                                                        <Binding Path="MaxPlayers" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- Global workspace title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Grid.Row="0"
                  Background="{DynamicResource RailBrush}"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="TitleBar_OnPreviewMouseLeftButtonUp"
                  Panel.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="18,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="75"
                           Height="37"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="赫朝品牌标识">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source"
                                        Value="/Hechao.Launcher;component/Assets/hechao-launcher-lockup-hd-dark.png" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseDarkMode}" Value="False">
                                        <Setter Property="Source"
                                                Value="/Hechao.Launcher;component/Assets/hechao-launcher-lockup-hd-light.png" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="启动器"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LauncherVersionText}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="{DynamicResource InkFaintBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="48"
                        Padding="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource WorkspaceNavigationToggleStyle}"
                                      IsChecked="{Binding IsServersPage, Mode=TwoWay}"
                                      Command="{Binding ShowServersCommand}"
                                      ToolTip="服务器"
                                      AutomationProperties.Name="服务器">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="Server" Width="17" Height="17" />
                                <TextBlock Text="服务器"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource WorkspaceNavigationToggleStyle}"
                                      IsChecked="{Binding IsActivitiesPage, Mode=TwoWay}"
                                      Command="{Binding ShowActivitiesCommand}"
                                      ToolTip="活动"
                                      AutomationProperties.Name="活动">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="Calendar" Width="17" Height="17" />
                                <TextBlock Text="活动"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource WorkspaceNavigationToggleStyle}"
                                      IsChecked="{Binding IsDownloadsPage, Mode=TwoWay}"
                                      Command="{Binding ShowDownloadsCommand}"
                                      ToolTip="下载中心"
                                      AutomationProperties.Name="下载中心">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="Download" Width="17" Height="17" />
                                <TextBlock Text="下载中心"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="42" Height="66">
                        <ToggleButton Style="{StaticResource QuietIconToggleButtonStyle}"
                                      Width="38"
                                      Height="38"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      ContentTemplate="{x:Null}"
                                      IsChecked="{Binding IsNotificationsOpen, Mode=TwoWay}"
                                      ToolTip="通知中心"
                                      AutomationProperties.Name="通知中心">
                            <controls:IconParkIcon Kind="Remind" Width="18" Height="18" />
                        </ToggleButton>
                    </Grid>
                    <Grid Width="42" Height="66">
                        <ToggleButton Width="38"
                                      Height="38"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      ContentTemplate="{x:Null}"
                                      IsChecked="{Binding UseDarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding ThemeToggleToolTip}"
                                      AutomationProperties.Name="黑夜模式">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton"
                                       BasedOn="{StaticResource QuietIconToggleButtonStyle}" />
                            </ToggleButton.Style>
                            <Grid Width="18" Height="18">
                                <controls:IconParkIcon Kind="Moon" Width="18" Height="18">
                                    <controls:IconParkIcon.Style>
                                        <Style TargetType="controls:IconParkIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseDarkMode}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:IconParkIcon.Style>
                                </controls:IconParkIcon>
                                <controls:IconParkIcon Kind="SunOne" Width="18" Height="18">
                                    <controls:IconParkIcon.Style>
                                        <Style TargetType="controls:IconParkIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseDarkMode}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:IconParkIcon.Style>
                                </controls:IconParkIcon>
                            </Grid>
                        </ToggleButton>
                    </Grid>
                    <Grid Width="42" Height="66">
                        <Button Style="{StaticResource TopBarPageIconButtonStyle}"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 ContentTemplate="{x:Null}"
                                 Command="{Binding ShowSettingsPageCommand}"
                                 ToolTip="启动器设置"
                                 AutomationProperties.Name="启动器设置">
                            <controls:IconParkIcon Kind="SettingTwo" Width="18" Height="18" />
                        </Button>
                    </Grid>
                    <Button Width="126"
                            Height="52"
                            Margin="3,7,8,7"
                            Padding="7,4"
                             Style="{StaticResource TopBarAccountButtonStyle}"
                             ContentTemplate="{x:Null}"
                             Command="{Binding ShowAccountCommand}"
                             ToolTip="{Binding AccountStatusText}"
                             AutomationProperties.Name="赫朝账户">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                             <Border Width="30"
                                     Height="30"
                                     Background="{DynamicResource HechaoRedSoftBrush}"
                                     BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4"
                                     ClipToBounds="True"
                                     SnapsToDevicePixels="True"
                                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                                     AutomationProperties.Name="Minecraft 皮肤头像">
                                <Grid>
                                    <controls:IconParkIcon Kind="User"
                                                           Width="15"
                                                           Height="15"
                                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                        <controls:IconParkIcon.Style>
                                            <Style TargetType="controls:IconParkIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAccountSkin}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:IconParkIcon.Style>
                                    </controls:IconParkIcon>
                                    <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                        Viewbox="8,8,8,8"
                                                        ViewboxUnits="Absolute"
                                                        Stretch="Fill"
                                                        TileMode="None" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                        Viewbox="40,8,8,8"
                                                        ViewboxUnits="Absolute"
                                                        Stretch="Fill"
                                                        TileMode="None" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                             </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountDisplayName}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TopBarAccountSubtitle}"
                                           FontSize="9"
                                           Foreground="{DynamicResource InkFaintBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Border Width="1"
                            Height="24"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Height="66"
                            ContentTemplate="{x:Null}"
                            Click="MinimizeButton_OnClick"
                            ToolTip="最小化"
                            AutomationProperties.Name="最小化窗口">
                        <controls:IconParkIcon Kind="Minus" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Height="66"
                            ContentTemplate="{x:Null}"
                            Click="MaximizeButton_OnClick"
                            ToolTip="最大化或还原"
                            AutomationProperties.Name="最大化或还原窗口">
                        <controls:IconParkIcon Kind="FullScreen" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Height="66"
                            ContentTemplate="{x:Null}"
                            Click="CloseButton_OnClick"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭启动器">
                        <controls:IconParkIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="3"
                        Height="1"
                        Background="{DynamicResource BorderBrush}"
                        VerticalAlignment="Bottom" />
            </Grid>

            <!-- Server inspector -->
            <Grid x:Name="ServerWorkspace"
                  Grid.Column="2"
                  Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}"
                  Visibility="{Binding IsServersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{DynamicResource StripBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <controls:IconParkIcon Kind="Server"
                                           Width="16"
                                           Height="16"
                                           Foreground="{DynamicResource InkFaintBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="服务器详情"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button x:Name="ServerActionsButton"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            Style="{StaticResource QuietIconButtonStyle}"
                            ContentTemplate="{x:Null}"
                            Click="ServerActionsButton_OnClick"
                            ToolTip="客户端操作"
                            AutomationProperties.Name="打开客户端操作菜单">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ServerActionsContextMenu"
                                         Style="{StaticResource ServerActionMenuStyle}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Placement="Bottom">
                                <MenuItem Header="回滚客户端"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          IsEnabled="{Binding CanRollbackSelectedProfile}"
                                          ToolTip="{Binding RollbackProfileToolTip}"
                                          Click="RollbackProfileButton_OnClick"
                                          AutomationProperties.Name="回滚客户端">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="History" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="校验并修复客户端"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          Command="{Binding RepairCommand}"
                                          AutomationProperties.Name="校验并修复客户端">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="Repair" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除客户端"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          IsEnabled="{Binding CanDeleteSelectedProfile}"
                                          ToolTip="{Binding DeleteProfileToolTip}"
                                          Click="DeleteProfileButton_OnClick"
                                          AutomationProperties.Name="删除客户端">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="Delete" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="客户端设置"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          Command="{Binding ShowSettingsPageCommand}"
                                          AutomationProperties.Name="打开客户端设置">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="SettingTwo" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ServerActionMenuSeparatorStyle}" />
                                <MenuItem Header="Java 自动"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          Command="{Binding UseManagedJavaCommand}"
                                          AutomationProperties.Name="使用客户端自带 Java">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="Code" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Java 自定义"
                                          Style="{StaticResource ServerActionMenuItemStyle}"
                                          Click="ChooseProfileJavaButton_OnClick"
                                          IsEnabled="{Binding CanUseProfileJavaActions}"
                                          AutomationProperties.Name="选择自定义 Java">
                                    <MenuItem.Icon>
                                        <controls:IconParkIcon Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <controls:IconParkIcon Kind="More" Width="17" Height="17" />
                    </Button>
                    <Border Grid.ColumnSpan="3"
                            Height="1"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="SelectedServerHeroPanel"
                            Padding="22,18,16,28"
                            Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <Border x:Name="SelectedServerHeroImage"
                                    Height="184"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    ClipToBounds="True"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Hechao.Launcher;component/Assets/hechao-fortress-banner.png"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <Grid x:Name="SelectedServerHeroDetails"
                                  Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedServer.Name}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedServerCategoryText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkFaintBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="9,4"
                                            Margin="12,0,0,0"
                                            Background="{DynamicResource SurfacePressedBrush}"
                                            CornerRadius="4"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedServerStatusText}"
                                                   FontSize="11"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ClosedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                                     Value="{x:Static contracts:ServerStatus.Online}">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedServer.Status}"
                                                                     Value="{x:Static contracts:ServerStatus.Maintenance}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedServerDescriptionText}"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,9,0,0"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="2"
                                        Height="1"
                                        Margin="0,17,0,0"
                                        Background="{DynamicResource BorderBrush}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="游戏版本"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <Binding Path="SelectedServer.MinecraftVersion"
                                                     StringFormat="Minecraft {0}" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="加载器"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                    <TextBlock Text="{Binding SelectedServerLoaderText}"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="开放后权限"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                    <TextBlock Text="{Binding SelectedServerAccessText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedServerAccessText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="在线人数"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                    <TextBlock Text="{Binding SelectedServerPlayerText}"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,1,0,0"
                                    Padding="10,8"
                                    Background="{DynamicResource StripBrush}"
                                    CornerRadius="5"
                                    Visibility="{Binding HasSelectedServerSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Calendar"
                                                           Width="13"
                                                           Height="13"
                                                           Foreground="{DynamicResource SteelBrush}"
                                                           Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SelectedServerScheduleText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="客户端"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Margin="0,22,0,10" />
                            <Border Padding="13,11"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconParkIcon Kind="Box"
                                                           Width="18"
                                                           Height="18"
                                                           Foreground="{DynamicResource HechaoRedBrush}"
                                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="4,0,10,0">
                                        <TextBlock Text="{Binding SelectedProfileDisplayName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedProfileDisplayName}" />
                                        <TextBlock Text="{Binding SelectedProfileMetaText}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource InkFaintBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ClientStatusText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ClientStatusText}" />
                                </Grid>
                            </Border>

                            <Border x:Name="HomeQuickSettingsPanel"
                                    Margin="0,22,0,0"
                                    Background="Transparent">
                                <Grid x:Name="HomeQuickSettingsGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="运行设置"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,0,0,10" />
                                    <StackPanel x:Name="HomeQuickSettingFields"
                                                Grid.Row="1">
                                        <Border x:Name="HomeJavaQuickSetting"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7,7,0,0">
                                            <Button Height="46"
                                                    MinHeight="46"
                                                    Padding="12,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Click="ChooseProfileJavaButton_OnClick"
                                                    IsEnabled="{Binding CanUseProfileJavaActions}"
                                                    ToolTip="更改当前档案 Java"
                                                    AutomationProperties.Name="更改当前档案 Java">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Java"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource InkFaintBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SelectedProfileJavaVersionText}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <controls:IconParkIcon Grid.Column="2"
                                                                           Kind="Right"
                                                                           Width="11"
                                                                           Height="11"
                                                                           Foreground="{DynamicResource InkFaintBrush}"
                                                                           VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                        <Border x:Name="HomeMemoryQuickSetting"
                                                Margin="0,-1,0,0"
                                                Padding="12,0"
                                                Height="46"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="运行内存"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkFaintBrush}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox x:Name="HomeMemorySelector"
                                                          Grid.Column="1"
                                                          Height="34"
                                                          MinWidth="0"
                                                          Style="{StaticResource MemoryComboBoxStyle}"
                                                          ItemsSource="{Binding MemoryOptions}"
                                                          SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="调整当前客户端游戏内存"
                                                          AutomationProperties.Name="当前客户端游戏内存" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="HomeDirectoryQuickSetting"
                                                Margin="0,-1,0,0"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="0,0,7,7">
                                            <Button x:Name="OpenHomeProfileDirectoryButton"
                                                    Height="46"
                                                    MinHeight="46"
                                                    Padding="12,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Command="{Binding OpenSelectedProfileGameDirectoryCommand}"
                                                    ToolTip="打开当前档案游戏目录"
                                                    AutomationProperties.Name="打开当前档案游戏目录">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="当前目录"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource InkFaintBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="HomeClientDirectoryText"
                                                               Grid.Column="1"
                                                               Text="{Binding SelectedProfileGameDirectoryDisplayText}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SelectedProfileGameDirectoryDisplayText}"
                                                               AutomationProperties.HelpText="{Binding SelectedProfileGameDirectoryDisplayText}"
                                                               VerticalAlignment="Center" />
                                                    <controls:IconParkIcon Grid.Column="2"
                                                                           Kind="FolderOpen"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Foreground="{DynamicResource InkFaintBrush}"
                                                                           VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="公告"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Margin="0,22,0,10" />
                            <Border Padding="12,11"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="6">
                                <TextBlock Text="{Binding SelectedServerDescriptionText}"
                                           FontSize="11"
                                           LineHeight="18"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid x:Name="SelectedServerHeroActions"
                      Grid.Row="2"
                      Background="{DynamicResource SurfaceMutedBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Top" />
                    <Button x:Name="SelectedServerPrimaryActionButton"
                            Height="46"
                            MinHeight="46"
                            Margin="22,15"
                            Padding="18,8"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding PrimaryActionCommand}"
                            ToolTip="{Binding PrimaryActionToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding PrimaryActionText}">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconParkIcon Glyph="{Binding PrimaryActionGlyph}"
                                                   Width="16"
                                                   Height="16"
                                                   Foreground="White"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryActionText}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Downloads page -->
            <Border x:Name="DownloadDirectoryPanel"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource DirectoryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsDownloadsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource WorkspacePageHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="下载中心"
                                           Style="{StaticResource PageHeaderTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{DynamicResource OnlineBrush}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DownloadQueueStatusText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Style="{StaticResource QuietIconButtonStyle}"
                                    ContentTemplate="{x:Null}"
                                    Command="{Binding OpenClientDirectoryCommand}"
                                    ToolTip="打开游戏数据目录"
                                    AutomationProperties.Name="打开游戏数据目录">
                                <controls:IconParkIcon Kind="FolderOpen"
                                                       Width="16"
                                                       Height="16" />
                            </Button>
                            <Button Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    Style="{StaticResource QuietIconButtonStyle}"
                                    ContentTemplate="{x:Null}"
                                    Command="{Binding ClearDownloadHistoryCommand}"
                                    ToolTip="清空下载历史"
                                    AutomationProperties.Name="清空下载历史">
                                <controls:IconParkIcon Kind="Delete"
                                                       Width="16"
                                                       Height="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="28,0,14,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="下载历史"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DownloadHistoryCount, StringFormat={}{0} 条记录}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkFaintBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding DownloadHistory}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="下载历史">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource PageListItemStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding ProgressText}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,13"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="138" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26"
                                                        Height="26"
                                                        Background="{DynamicResource SteelSoftBrush}"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center">
                                                    <controls:IconParkIcon Kind="Download"
                                                                           Width="12"
                                                                           Height="12"
                                                                           Foreground="{DynamicResource SteelBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0,16,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FailureMessage}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Version, StringFormat=版本 {0}}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource InkFaintBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HechaoRedDarkBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已取消">
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource InkFaintBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Margin="28"
                                        MaxWidth="320"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasNoDownloadHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:IconParkIcon Kind="Download"
                                                       Width="24"
                                                       Height="24"
                                                       Foreground="{DynamicResource InkFaintBrush}"
                                                       HorizontalAlignment="Center" />
                                <TextBlock Text="还没有下载记录"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,0"
                                           TextAlignment="Center" />
                                <TextBlock Text="安装、更新和修复记录会显示在这里。"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,5,0,0"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DownloadInspector"
                  Grid.Column="2"
                  Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}"
                  Visibility="{Binding IsDownloadsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <controls:IconParkIcon Kind="Download"
                                               Width="16"
                                               Height="16"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="传输详情"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,20,18,28">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveDownload}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource HechaoRedSoftBrush}"
                                        BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="18"
                                                           Height="18"
                                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="当前任务"
                                           Style="{StaticResource PageEyebrowStyle}"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="{Binding ActiveDownload.DisplayName}"
                                           FontSize="23"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource InkBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding ActiveDownload.ProgressText}"
                                           FontFamily="Segoe UI"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,10,0,0" />
                                <controls:AnimatedProgressBar Style="{StaticResource HechaoProgressBarStyle}"
                                                              Value="{Binding ActiveDownload.Percent, Mode=OneWay}"
                                                              Maximum="100"
                                                              Margin="0,16,0,0"
                                                              AutomationProperties.Name="当前下载进度" />
                                <TextBlock Text="{Binding ActiveDownload.CurrentFile}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,13,0,0" />
                                <TextBlock Text="{Binding ActiveDownload.Version, StringFormat=客户端版本 {0}}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkFaintBrush}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoActiveDownload}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SteelSoftBrush}"
                                        CornerRadius="5">
                                    <controls:IconParkIcon Kind="CheckOne"
                                                           Width="18"
                                                           Height="18"
                                                           Foreground="{DynamicResource SteelBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="传输队列"
                                           Style="{StaticResource PageEyebrowStyle}"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="当前没有下载任务"
                                           FontSize="23"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource InkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding DownloadQueueStatusText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,9,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,24,0,6" />
                        <Border Style="{StaticResource WorkspaceFlatRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="FolderOpen"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="{DynamicResource InkFaintBrush}"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="游戏数据目录"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ClientDirectory}"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ClientDirectory}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="18,10"
                        Background="{DynamicResource StripBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding OpenClientDirectoryCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="打开下载目录">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconParkIcon Kind="FolderOpen"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,8,0" />
                                <TextBlock Text="打开目录" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding CancelDownloadCommand}"
                                Content="取消任务"
                                AutomationProperties.Name="取消当前下载">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DangerButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveDownload}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Activities page -->
            <Border x:Name="ActivityCalendarPanel"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource DirectoryBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsActivitiesPage, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource WorkspacePageHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="活动"
                                           Style="{StaticResource PageHeaderTitleStyle}" />
                                <TextBlock Text="{Binding ActivityCalendar.MonthSummaryText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkFaintBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Style="{StaticResource QuietIconButtonStyle}"
                                    ContentTemplate="{x:Null}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="刷新活动状态"
                                    AutomationProperties.Name="刷新活动状态">
                                <controls:IconParkIcon Kind="Refresh"
                                                       Width="16"
                                                       Height="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <controls:LiveRegionBorder x:Name="ActivityCalendarStatusLiveRegion"
                                               Grid.Row="1"
                                               Margin="28,0,14,10"
                                               Padding="13,10"
                                               Background="{DynamicResource StripBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="4"
                                               AutomationProperties.Name="活动日历状态"
                                               AutomationProperties.ItemStatus="{Binding ActivityCalendarStatusMessage}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="{Binding IsActivityCalendarStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconParkIcon Kind="Calendar"
                                                   Width="16"
                                                   Height="16"
                                                   Margin="0,1,10,0"
                                                   Foreground="{DynamicResource HechaoRedDarkBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ActivityCalendarStatusTitle}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActivityCalendarStatusMessage}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    MinWidth="82"
                                    Height="32"
                                    Margin="14,0,0,0"
                                    Padding="10,4"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="重新加载"
                                    Command="{Binding RefreshCommand}"
                                    AutomationProperties.Name="重新加载活动日历" />
                        </Grid>
                    </controls:LiveRegionBorder>

                    <Border x:Name="ActivityCalendarSurface"
                            Grid.Row="2"
                            Margin="28,0,14,18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ActivityCalendarMonthHeader"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActivityCalendar.DisplayedMonthText}"
                                                   FontSize="17"
                                                   FontWeight="Black" />
                                        <TextBlock Text="{Binding ActivityCalendar.MonthSummaryText}"
                                                   Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource InkFaintBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Width="34"
                                                Height="34"
                                                MinHeight="34"
                                                Padding="0"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding ActivityCalendar.PreviousMonthCommand}"
                                                ToolTip="上个月"
                                                AutomationProperties.Name="查看上个月">
                                            <controls:IconParkIcon Kind="Left"
                                                                   Width="14"
                                                                   Height="14" />
                                        </Button>
                                        <Button Height="34"
                                                MinHeight="34"
                                                Margin="6,0"
                                                Padding="10,5"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding ActivityCalendar.GoToTodayCommand}"
                                                AutomationProperties.Name="回到今天">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconParkIcon Kind="Calendar"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Margin="0,0,6,0" />
                                                <TextBlock Text="今天" />
                                            </StackPanel>
                                        </Button>
                                        <Button Width="34"
                                                Height="34"
                                                MinHeight="34"
                                                Padding="0"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding ActivityCalendar.NextMonthCommand}"
                                                ToolTip="下个月"
                                                AutomationProperties.Name="查看下个月">
                                            <controls:IconParkIcon Kind="Right"
                                                                   Width="14"
                                                                   Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="ActivityCalendarWeekHeader"
                                    Grid.Row="1"
                                    Background="{DynamicResource StripBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <UniformGrid Columns="7" VerticalAlignment="Center">
                                    <TextBlock Text="周一" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周二" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周三" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周四" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周五" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周六" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="周日" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Center" />
                                </UniformGrid>
                            </Border>

                            <ItemsControl x:Name="ActivityCalendarDays"
                                          Grid.Row="2"
                                          ItemsSource="{Binding ActivityCalendar.Days}"
                                          AutomationProperties.Name="活动月历日期">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ActivityCalendarDayButtonStyle}"
                                                Command="{Binding DataContext.ActivityCalendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding AutomationName}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HechaoRedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DayNumber}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <ItemsControl Grid.Row="1"
                                                              Margin="1,5,0,0"
                                                              ItemsSource="{Binding VisibleActivities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="18" Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Style="{StaticResource ActivityStatusDotStyle}"
                                                                         Margin="0,0,5,0"
                                                                         VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Server.Name}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding HiddenActivityText}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                           Visibility="{Binding HasHiddenActivities, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="ActivityInspector"
                  Grid.Column="2"
                  Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}"
                  Visibility="{Binding IsActivitiesPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ActivityInspectorHeader"
                        Grid.Row="0"
                        Style="{StaticResource WorkspaceInspectorHeaderStyle}"
                        BorderBrush="{DynamicResource DividerBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <controls:IconParkIcon Kind="Calendar"
                                               Width="16"
                                               Height="16"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="活动详情"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="ActivitySelectedDateHeader"
                                Padding="22,19"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{Binding ActivityCalendar.SelectedDateText}"
                                           FontSize="21"
                                           FontWeight="Black" />
                                <TextBlock Text="{Binding ActivityCalendar.SelectedDateSummaryText}"
                                           Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ListBox x:Name="SelectedActivityList"
                                     ItemsSource="{Binding ActivityCalendar.SelectedActivities}"
                                     ItemTemplate="{StaticResource ActivityCalendarDetailTemplate}"
                                     ItemContainerStyle="{StaticResource ActivityCalendarDetailItemStyle}"
                                     Style="{StaticResource ActivityCalendarListStyle}"
                                     IsEnabled="{Binding CanSelectServer}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="所选日期的活动" />
                            <StackPanel Margin="30,42"
                                        HorizontalAlignment="Center"
                                        MaxWidth="280"
                                        Visibility="{Binding ActivityCalendar.HasNoSelectedActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:IconParkIcon Kind="Calendar"
                                                       Width="24"
                                                       Height="24"
                                                       Foreground="{DynamicResource InkFaintBrush}"
                                                       HorizontalAlignment="Center" />
                                <TextBlock Text="当天暂无活动"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="选择带有标记的日期查看开放安排。"
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ActivityUnscheduledSection"
                                Margin="22,20,18,0"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding ActivityCalendar.HasUnscheduledActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,18,0,8">
                                    <TextBlock Text="待排期"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ActivityCalendar.UnscheduledActivityCount, StringFormat={}{0} 项}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ListBox x:Name="UnscheduledActivityList"
                                         ItemsSource="{Binding ActivityCalendar.UnscheduledActivities}"
                                         ItemTemplate="{StaticResource ActivityCalendarDetailTemplate}"
                                         ItemContainerStyle="{StaticResource ActivityCalendarDetailItemStyle}"
                                         Style="{StaticResource ActivityCalendarListStyle}"
                                         IsEnabled="{Binding CanSelectServer}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="待排期活动" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <!-- Hechao account page -->
            <Grid x:Name="AccountWorkspace"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{DynamicResource CanvasBrush}"
                  Visibility="{Binding IsAccountPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AccountDirectoryPanel"
                        Grid.Column="0"
                        Background="{DynamicResource DirectoryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource WorkspacePageHeaderStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="赫朝账户"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <TextBlock Text="社区身份与正版验证"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkFaintBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid x:Name="AccountGuestDirectory">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel Margin="20,18,18,24"
                                        VerticalAlignment="Top">
                                <Border Width="52"
                                        Height="52"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource HechaoRedSoftBrush}"
                                        BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <controls:IconParkIcon Kind="User"
                                                           Width="22"
                                                           Height="22"
                                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="登录赫朝身份"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="登录后可同步成员等级、活动资格和 Minecraft 正版身份。"
                                           FontSize="12"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           Margin="0,7,0,20" />

                                <Border Style="{StaticResource WorkspaceFlatRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconParkIcon Kind="User"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                               VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="赫朝身份"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="社区昵称、等级与活动资格"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource WorkspaceFlatRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconParkIcon Kind="Shield"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="{DynamicResource SteelBrush}"
                                                               VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Minecraft Java"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Microsoft 正版所有权验证"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconParkIcon Kind="Shield"
                                                           Width="15"
                                                           Height="15"
                                                           Foreground="{DynamicResource InkFaintBrush}"
                                                           Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="Microsoft 密码只在官方登录页面中输入。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="AccountProfileDirectory">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel Margin="20,16,18,22">
                                    <Border x:Name="AccountProfileAvatar"
                                            Width="56"
                                            Height="56"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource HechaoRedSoftBrush}"
                                            BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            AutomationProperties.Name="Minecraft 皮肤头像">
                                        <Grid>
                                            <controls:IconParkIcon Kind="User"
                                                                   Width="30"
                                                                   Height="30"
                                                                   Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                <controls:IconParkIcon.Style>
                                                    <Style TargetType="controls:IconParkIcon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAccountSkin}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:IconParkIcon.Style>
                                            </controls:IconParkIcon>
                                            <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                                Viewbox="8,8,8,8"
                                                                ViewboxUnits="Absolute"
                                                                Stretch="Fill"
                                                                TileMode="None" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Visibility="{Binding HasAccountSkin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding AccountSkinSource}"
                                                                Viewbox="40,8,8,8"
                                                                ViewboxUnits="Absolute"
                                                                Stretch="Fill"
                                                                TileMode="None" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontSize="20"
                                               FontWeight="Black"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding AccountUsername}"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,4,0,0" />

                                    <Border Margin="0,16,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource OnlineBrush}"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="账户状态"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkFaintBrush}" />
                                                <TextBlock Text="{Binding AccountStatusText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <StackPanel>
                                            <TextBlock Text="当前权限"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkFaintBrush}" />
                                            <TextBlock Text="{Binding AccountAccessText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

                <Grid x:Name="AccountInspector"
                      Grid.Column="1"
                      Background="{DynamicResource SurfaceBrush}">
                <Grid x:Name="AccountGuestContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                        <Grid>
                            <TextBlock Text="登录与注册"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="赫朝身份"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkFaintBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                            <TabControl Style="{StaticResource AccountTabControlStyle}">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem"
                                           BasedOn="{StaticResource AccountTabStyle}" />
                                </TabControl.Resources>
                                <TabItem Header="登录">
                                    <Grid Margin="0,22,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="账号名或邮箱"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="LoginIdentifierTextBox"
                                                 Grid.Row="1"
                                                 Style="{StaticResource TextFieldStyle}"
                                                 AutomationProperties.Name="赫朝账号名或邮箱" />
                                        <TextBlock Grid.Row="2"
                                                   Text="密码"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Margin="0,16,0,6" />
                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     Grid.Row="3"
                                                     Style="{StaticResource PasswordFieldStyle}"
                                                     AutomationProperties.Name="赫朝账号密码" />
                                        <Button Grid.Row="4"
                                                Height="46"
                                                Margin="0,22,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanSubmitAccountForms}"
                                                AutomationProperties.Name="登录赫朝账号"
                                                Click="LoginAccountButton_OnClick">
                                            <TextBlock Text="登录赫朝账号"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="注册">
                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="账号名"
                                                   Style="{StaticResource FormLabelStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="显示名称"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Margin="8,0,0,6" />
                                        <TextBox x:Name="RegisterUsernameTextBox"
                                                 Grid.Row="1"
                                                 Margin="0,0,8,0"
                                                 Style="{StaticResource TextFieldStyle}"
                                                 AutomationProperties.Name="赫朝账号名" />
                                        <TextBox x:Name="RegisterDisplayNameTextBox"
                                                 Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 Style="{StaticResource TextFieldStyle}"
                                                 AutomationProperties.Name="显示名称" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Text="邮箱"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Margin="0,16,0,6" />
                                        <Grid Grid.Row="3"
                                              Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="126" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RegisterEmailTextBox"
                                                     Margin="0,0,8,0"
                                                     Style="{StaticResource TextFieldStyle}"
                                                     AutomationProperties.Name="邮箱" />
                                            <Button x:Name="SendRegistrationCodeButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    IsEnabled="{Binding CanSendRegistrationCode}"
                                                    Click="SendRegistrationCodeButton_OnClick"
                                                    AutomationProperties.Name="{Binding RegistrationCodeActionText}">
                                                <TextBlock Text="{Binding RegistrationCodeActionText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="4"
                                                   Text="邮箱验证码"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Margin="0,16,8,6" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="密码"
                                                   Style="{StaticResource FormLabelStyle}"
                                                   Margin="8,16,0,6" />
                                        <TextBox x:Name="RegisterCodeTextBox"
                                                 Grid.Row="5"
                                                 MaxLength="6"
                                                 Margin="0,0,8,0"
                                                 Style="{StaticResource TextFieldStyle}"
                                                 AutomationProperties.Name="6 位邮箱验证码" />
                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                     Grid.Row="5"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     Style="{StaticResource PasswordFieldStyle}"
                                                     AutomationProperties.Name="注册密码" />
                                        <TextBlock Grid.Row="6"
                                                   Grid.ColumnSpan="2"
                                                   Text="密码至少 10 位，并同时包含字母与数字。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkFaintBrush}"
                                                   Margin="0,6,0,0" />
                                        <CheckBox Grid.Row="7"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,12,0,0"
                                                  Foreground="{DynamicResource InkMutedBrush}"
                                                  IsChecked="{Binding IsRegistrationLegalAccepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="同意用户协议、隐私政策与社区规则">
                                            <TextBlock Text="我已阅读并同意用户协议、隐私政策与社区规则"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </CheckBox>
                                        <Button Grid.Row="8"
                                                Grid.ColumnSpan="2"
                                                Height="46"
                                                Margin="0,18,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanSubmitRegistrationForm}"
                                                AutomationProperties.Name="创建赫朝账号"
                                                Click="RegisterAccountButton_OnClick">
                                            <TextBlock Text="创建赫朝账号"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <controls:LiveRegionBorder x:Name="AccountFormLiveRegion"
                                                       Margin="0,14,0,0"
                                                       AutomationProperties.Name="赫朝账号表单状态"
                                                       AutomationProperties.ItemStatus="{Binding AccountFormMessage}"
                                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock Text="{Binding AccountFormMessage}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextTrimming="None">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SteelBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccountFormError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource HechaoRedDarkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </controls:LiveRegionBorder>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AccountAuthenticatedContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                        <Grid>
                            <TextBlock Text="身份与安全"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="正版验证与设备会话"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkFaintBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                            <TextBlock Text="身份与权限"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <TextBlock Text="管理 Minecraft 正版身份与服务器权限。"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <Border Margin="0,18,0,0"
                                    Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{DynamicResource SteelSoftBrush}"
                                            CornerRadius="4"
                                            VerticalAlignment="Top">
                                        <controls:IconParkIcon Kind="Shield"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="{DynamicResource SteelBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="Minecraft Java 正版身份"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MinecraftLinkStatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding MinecraftIdentityText}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="2"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                            <Button Command="{Binding LinkMinecraftCommand}"
                                                    AutomationProperties.Name="绑定 Microsoft 正版身份">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource SettingsPrimaryActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMinecraftLinked}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="绑定 Microsoft 正版身份"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           FontWeight="Bold" />
                                            </Button>
                                            <Button Command="{Binding UnlinkMinecraftCommand}"
                                                    Content="解除 Minecraft 绑定">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource SettingsActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMinecraftLinked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="18"
                                    Background="{DynamicResource HechaoRedSoftBrush}"
                                    BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Visibility="{Binding IsMinecraftUnlinkFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="确认解除 Minecraft 绑定"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1"
                                               Text="请输入当前赫朝账号密码确认。解绑会撤销所有设备上的待用进服授权。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="UnlinkMinecraftPasswordBox"
                                                     Height="40"
                                                     MaxLength="128"
                                                     Style="{StaticResource PasswordFieldStyle}"
                                                     ToolTip="当前赫朝账号密码"
                                                     AutomationProperties.Name="当前赫朝账号密码" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                AutomationProperties.Name="取消解除 Minecraft 绑定"
                                                Click="CancelMinecraftUnlinkButton_OnClick"
                                                Content="取消" />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource SettingsDangerActionButtonStyle}"
                                                AutomationProperties.Name="确认解除 Minecraft 绑定"
                                                Click="ConfirmMinecraftUnlinkButton_OnClick"
                                                Content="确认解除" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{DynamicResource HechaoRedSoftBrush}"
                                            CornerRadius="4"
                                            VerticalAlignment="Top">
                                        <controls:IconParkIcon Kind="Lock"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="LuckPerms 权限"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AccountAccessText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                        <Button Grid.Column="2"
                                                Command="{Binding OpenAdminConsoleCommand}"
                                                 Content="{Binding AdminConsoleButtonText}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource SettingsActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="会话安全"
                                       Style="{StaticResource SettingsSectionLabelStyle}"
                                       Margin="0,22,0,0" />
                            <TextBlock Text="管理当前设备和其他已登录设备的会话。"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="当前设备"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="仅退出这台电脑上的赫朝账户。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SettingsActionButtonStyle}"
                                            Command="{Binding LogoutAccountCommand}"
                                            Content="退出当前设备" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="所有设备"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="撤销这个账户在全部设备上的登录会话。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SettingsDangerActionButtonStyle}"
                                            Command="{Binding LogoutAllDevicesCommand}"
                                            Content="退出所有设备" />
                                </Grid>
                            </Border>

                            <controls:LiveRegionBorder x:Name="AuthenticatedAccountFormLiveRegion"
                                                       Margin="0,16,0,0"
                                                       Padding="16"
                                                       Background="{DynamicResource StripBrush}"
                                                       BorderBrush="{DynamicResource BorderBrush}"
                                                       BorderThickness="1"
                                                       CornerRadius="5"
                                                       AutomationProperties.Name="赫朝账户状态"
                                                       AutomationProperties.ItemStatus="{Binding AccountFormMessage}"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       Visibility="{Binding HasAccountFormMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding AccountFormMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </controls:LiveRegionBorder>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Grid>


            <!-- Settings page -->
            <Grid x:Name="SettingsWorkspace"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Grid.Row="1"
                  Background="{DynamicResource CanvasBrush}"
                  Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TabControl x:Name="SettingsWorkspaceTabs"
                            Grid.ColumnSpan="2"
                            SelectedIndex="0"
                            Style="{StaticResource SettingsWorkspaceTabControlStyle}"
                            AutomationProperties.Name="设置分类">
                    <TabItem x:Name="SettingsGameTab"
                             Style="{StaticResource SettingsCategoryTabItemStyle}">
                        <TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="Code"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="游戏与运行"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="内存与启动行为"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <Grid x:Name="SettingsGamePanel"
                              Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                                <Grid>
                                    <TextBlock Text="游戏与运行"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="内存与启动行为"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="SettingsGameScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                                    <TextBlock Text="运行参数"
                                               Style="{StaticResource SettingsSectionLabelStyle}" />
                                    <TextBlock Text="这些偏好适用于启动器管理的全部客户端档案。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <Border Margin="0,18,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <StackPanel>
                                            <TextBlock Text="默认游戏内存"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="选择新启动游戏使用的内存上限。"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       Margin="0,4,0,12" />
                                            <ListBox Style="{StaticResource MemorySegmentListStyle}"
                                                     ItemContainerStyle="{StaticResource MemorySegmentItemStyle}"
                                                     ItemsSource="{Binding MemoryOptions}"
                                                     SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="默认游戏内存" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="游戏启动后关闭启动器"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Minecraft 进程成功创建后自动退出启动器。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource SwitchToggleStyle}"
                                                          IsChecked="{Binding CloseLauncherAfterGameStart, Mode=TwoWay}"
                                                          AutomationProperties.Name="游戏启动后关闭启动器"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="SettingsClientTab"
                             Style="{StaticResource SettingsCategoryTabItemStyle}">
                        <TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="Download"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="客户端与下载"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="目录、更新与缓存"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <Grid x:Name="SettingsClientPanel"
                              Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                                <Grid>
                                    <TextBlock Text="客户端与下载"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="目录、更新与缓存"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="SettingsClientScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                                    <TextBlock Text="存储位置"
                                               Style="{StaticResource SettingsSectionLabelStyle}" />
                                    <TextBlock Text="目录变更不会移动已有文件；新的安装会写入新位置。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <Border Margin="0,18,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <StackPanel>
                                            <TextBlock Text="游戏数据目录"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="40"
                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding ClientDirectory}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="11,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ClientDirectory}"
                                                               AutomationProperties.HelpText="{Binding ClientDirectory}" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SettingsActionButtonStyle}"
                                                        Margin="10,0,0,0"
                                                        Click="ChooseClientDirectoryButton_OnClick"
                                                        IsEnabled="{Binding CanChangeClientDirectory}"
                                                        Content="更改目录"
                                                        AutomationProperties.Name="更改游戏数据目录" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="更新与下载"
                                               Style="{StaticResource SettingsSectionLabelStyle}"
                                               Margin="0,22,0,0" />

                                    <Border Margin="0,6,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="启动时检查客户端更新"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="进入服务器前比较客户端档案与最新发布清单。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource SwitchToggleStyle}"
                                                          IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                                          AutomationProperties.Name="启动时检查客户端更新"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="启动器版本"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="手动检查启动器是否已有新版本。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    Command="{Binding CheckLauncherUpdateCommand}"
                                                    AutomationProperties.Name="检查启动器更新">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconParkIcon Kind="CheckOne"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Margin="0,0,7,0" />
                                                    <TextBlock Text="立即检查" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="保留已下载文件缓存"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="保留校验通过的下载文件，供后续安装、更新或修复复用。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource SwitchToggleStyle}"
                                                          IsChecked="{Binding KeepDownloadsAfterClose, Mode=TwoWay}"
                                                          AutomationProperties.Name="保留已下载文件缓存"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="安装时打开下载中心"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="开始安装或修复后自动切换到实时下载页面。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource SwitchToggleStyle}"
                                                          IsChecked="{Binding OpenDownloadsWhenInstalling, Mode=TwoWay}"
                                                          AutomationProperties.Name="安装时打开下载中心"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="使用 Windows 系统代理"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="关闭时直连；切换后下次启动生效。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource SwitchToggleStyle}"
                                                          IsChecked="{Binding UseSystemProxy, Mode=TwoWay}"
                                                          AutomationProperties.Name="使用 Windows 系统代理"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="SettingsBehaviorTab"
                             Style="{StaticResource SettingsCategoryTabItemStyle}">
                        <TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="SettingTwo"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="启动器行为"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="首页与本机数据"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <Grid x:Name="SettingsBehaviorPanel"
                              Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                                <Grid>
                                    <TextBlock Text="启动器行为"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="首页与本机数据"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="SettingsBehaviorScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                                    <TextBlock Text="打开方式"
                                               Style="{StaticResource SettingsSectionLabelStyle}" />

                                    <Border Margin="0,6,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="178" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="默认打开页面"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="下次启动时首先显示的工作区。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource MemoryComboBoxStyle}"
                                                      ItemsSource="{Binding StartupPageOptions}"
                                                      SelectedItem="{Binding SelectedStartupPage, Mode=TwoWay}"
                                                      AutomationProperties.Name="默认打开页面"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="本机数据"
                                               Style="{StaticResource SettingsSectionLabelStyle}"
                                               Margin="0,22,0,0" />

                                    <Border Margin="0,6,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="游戏数据目录"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="查看客户端档案、缓存与运行时文件。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    Command="{Binding OpenClientDirectoryCommand}"
                                                    Content="打开目录"
                                                    AutomationProperties.Name="打开游戏数据目录" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="下载历史"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="移除本机的下载任务记录，不会删除客户端。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsDangerActionButtonStyle}"
                                                    Command="{Binding ClearDownloadHistoryCommand}"
                                                    Content="清空"
                                                    AutomationProperties.Name="清空下载历史" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="全部启动器偏好"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="恢复默认内存、目录、更新和打开方式。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsDangerActionButtonStyle}"
                                                    Command="{Binding ResetLauncherSettingsCommand}"
                                                    Content="恢复默认"
                                                    AutomationProperties.Name="恢复默认设置" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="SettingsDiagnosticsTab"
                             Style="{StaticResource SettingsCategoryTabItemStyle}">
                        <TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconParkIcon Kind="Tool"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="故障诊断"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="退出记录与诊断包"
                                               FontSize="10"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <Grid x:Name="SettingsDiagnosticsPanel"
                              Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspaceInspectorHeaderStyle}">
                                <Grid>
                                    <TextBlock Text="故障诊断"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="退出记录与诊断包"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="SettingsDiagnosticsScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Style="{StaticResource SettingsContentStackStyle}">
                                    <TextBlock Text="运行记录"
                                               Style="{StaticResource SettingsSectionLabelStyle}" />

                                    <Border Margin="0,12,0,0"
                                            Padding="15"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconParkIcon Kind="History"
                                                                   Width="17"
                                                                   Height="17"
                                                                   Foreground="{DynamicResource HechaoRedBrush}"
                                                                   VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="最近一次游戏退出"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding LatestGameExitText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="诊断包"
                                               Style="{StaticResource SettingsSectionLabelStyle}"
                                               Margin="0,24,0,0" />
                                    <TextBlock Text="诊断文件只保存在本机，不会自动上传。生成时会脱敏账号标识、令牌、网络地址与本机用户路径，并跳过世界存档。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding DiagnosticUploadStatus}"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,9,0,0"
                                               AutomationProperties.LiveSetting="Polite" />

                                    <Border Margin="0,16,0,0"
                                            Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="生成本机诊断包"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="整理当前日志并执行脱敏检查。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsPrimaryActionButtonStyle}"
                                                    Command="{Binding CreateDiagnosticBundleCommand}"
                                                    AutomationProperties.Name="生成脱敏诊断包">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:IconParkIcon Kind="Tool"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                               Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding DiagnosticActionText}"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="上传已生成的诊断包"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="上传前仍会要求确认，只发送刚刚生成的文件。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    IsEnabled="{Binding CanUploadDiagnosticBundle}"
                                                    Click="UploadDiagnosticButton_OnClick"
                                                    ToolTip="只上传刚刚由启动器生成的脱敏诊断包"
                                                    AutomationProperties.Name="上传脱敏诊断包">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconParkIcon Kind="ExternalTransmission"
                                                                           Width="14"
                                                                           Height="14"
                                                                           Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DiagnosticUploadActionText}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="诊断目录"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="查看已在本机生成的诊断文件。"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    Command="{Binding OpenDiagnosticsDirectoryCommand}"
                                                    AutomationProperties.Name="打开诊断目录">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconParkIcon Kind="FolderOpen"
                                                                           Width="14"
                                                                           Height="14"
                                                                           Margin="0,0,8,0" />
                                                    <TextBlock Text="打开目录"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Grid.Column="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource WorkspacePageHeaderStyle}"
                        Panel.ZIndex="2"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设置"
                                   Style="{StaticResource PageHeaderTitleStyle}" />
                        <TextBlock Text="本机偏好 · 即时保存"
                                   FontSize="11"
                                   Foreground="{DynamicResource InkFaintBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Notification center -->
            <Border x:Name="NotificationsPanel"
                    Grid.Column="2"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="360"
                    Margin="0,72,12,0"
                    Padding="18"
                    Panel.ZIndex="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    AutomationProperties.Name="通知中心"
                    Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource PanelShadowColor}"
                                      BlurRadius="12"
                                      ShadowDepth="3"
                                      Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="通知中心" FontSize="17" FontWeight="Black" />
                            <TextBlock Text="服务器与客户端动态"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="CloseNotificationsButton"
                                HorizontalAlignment="Right"
                                Style="{StaticResource QuietIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Content="&#xE711;"
                                Command="{Binding CloseOverlaysCommand}"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭通知中心" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,15,0,0"
                            Padding="0,15,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{DynamicResource HechaoRedSoftBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top">
                                <controls:IconParkIcon Kind="VolumeNotice"
                                                       Width="13"
                                                       Height="13"
                                                       Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="活动服开放安排"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="活动服务器会按录制计划开放，开放状态以服务器目录为准。"
                                           FontSize="12"
                                           LineHeight="16"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{DynamicResource SteelSoftBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Top">
                                <controls:IconParkIcon Kind="CheckOne"
                                                       Width="13"
                                                       Height="13"
                                                       Foreground="{DynamicResource SteelBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedProfileDisplayName}"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedProfileMetaText}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Settings drawer -->
            <Border Grid.Column="2"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="420"
                    Panel.ZIndex="22"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource PanelShadowColor}"
                                      BlurRadius="22"
                                      ShadowDepth="8"
                                      Direction="180" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="78" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,0,14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动器设置"
                                       FontSize="19"
                                       FontWeight="Black" />
                            <TextBlock Text="客户端、性能与启动行为"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource QuietIconButtonStyle}"
                                Width="36"
                                Height="36"
                                Content="&#xE711;"
                                Command="{Binding CloseOverlaysCommand}"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭设置面板" />
                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20">
                            <TextBlock Text="性能"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="56" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="126" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource HechaoRedSoftBrush}"
                                        CornerRadius="4">
                                    <TextBlock Text="RAM"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource HechaoRedDarkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="游戏内存" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="下次启动游戏时生效"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource MemoryComboBoxStyle}"
                                          ItemsSource="{Binding MemoryOptions}"
                                          SelectedItem="{Binding SelectedMemory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="游戏内存" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="存储"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid MinHeight="62" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="Folder"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,2,8,0">
                                    <TextBlock Text="游戏数据目录" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ClientDirectory}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               LineHeight="14"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding ClientDirectory}"
                                               AutomationProperties.HelpText="{Binding ClientDirectory}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource QuietIconButtonStyle}"
                                        Width="36"
                                        Height="36"
                                        Content="&#xE838;"
                                        Command="{Binding OpenClientDirectoryCommand}"
                                        ToolTip="打开游戏数据目录"
                                        AutomationProperties.Name="打开游戏数据目录"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="启动行为"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="50" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="CheckOne"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="启动时检查客户端更新" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="进入服务器前比较客户端档案与最新发布清单。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                              AutomationProperties.Name="启动时检查客户端更新"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="50" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="保留已下载文件缓存" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="供后续安装、更新或修复复用"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding KeepDownloadsAfterClose, Mode=TwoWay}"
                                              AutomationProperties.Name="保留已下载文件缓存"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="50" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="ExternalTransmission"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="使用 Windows 系统代理" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭时直连；下次启动生效"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding UseSystemProxy, Mode=TwoWay}"
                                              AutomationProperties.Name="使用 Windows 系统代理"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />

                            <TextBlock Text="账号与权限"
                                       Style="{StaticResource SettingsSectionLabelStyle}" />
                            <Grid Height="60" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfacePressedBrush}"
                                        CornerRadius="4">
                                    <controls:IconParkIcon Kind="User"
                                                           Width="14"
                                                           Height="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AccountAccessText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Height="36"
                                        Command="{Binding AccountActionCommand}"
                                        ToolTip="{Binding AccountActionTooltip}"
                                        AutomationProperties.Name="{Binding AccountActionTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconParkIcon Glyph="{Binding AccountActionGlyph}"
                                                               Width="13"
                                                               Height="13"
                                                               Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding AccountActionTooltip}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        <Button Style="{StaticResource BaseButtonStyle}"
                                Height="38"
                                Margin="42,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenAdminConsoleCommand}"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="在浏览器中打开安全管理后台"
                                AutomationProperties.Name="打开管理后台">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="ExternalTransmission"
                                                           Width="13"
                                                           Height="13"
                                                           Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AdminConsoleButtonText}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{DynamicResource StripBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="24,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LauncherVersionText, StringFormat=赫朝启动器 {0}}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="非 Minecraft 官方产品，与 Mojang 或 Microsoft 无关联。"
                                           FontSize="10"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource OnlineBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="设置自动保存"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Global Microsoft authentication -->
            <Border x:Name="MicrosoftSignInOverlay"
                    Grid.ColumnSpan="3"
                    Grid.RowSpan="2"
                    Panel.ZIndex="40"
                    Background="{DynamicResource OverlayBrush}"
                    FocusManager.IsFocusScope="True"
                    FocusManager.FocusedElement="{Binding ElementName=CancelMicrosoftSignInButton}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Visibility="{Binding IsMicrosoftSignInVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="520"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HechaoRedSoftBrush}"
                                    BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <controls:IconParkIcon Kind="ExternalTransmission"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding MicrosoftSignInTitle}"
                                           FontSize="20"
                                           FontWeight="Black" />
                                <TextBlock Text="MICROSOFT / MINECRAFT"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource HechaoRedDarkBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding MicrosoftSignInDescription}"
                                   FontSize="13"
                                   LineHeight="22"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,24,0,0" />

                        <Border Grid.Row="2"
                                Margin="0,22,0,0"
                                Padding="14"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="9"
                                        Height="9"
                                        Margin="1,2,12,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource OnlineBrush}"
                                        CornerRadius="5" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="浏览器窗口已打开"
                                               FontSize="13"
                                               FontWeight="Bold" />
                                    <TextBlock Text="如果没有看到浏览器，取消本次登录后重新点击绑定按钮。"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动器不会读取或保存你的 Microsoft 密码。"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkFaintBrush}"
                                       VerticalAlignment="Center" />
                        <Button x:Name="CancelMicrosoftSignInButton"
                                Grid.Column="1"
                                MinWidth="126"
                                Height="40"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding CancelMicrosoftSignInCommand}"
                                AutomationProperties.Name="取消 Microsoft 登录">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconParkIcon Kind="Close"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,7,0" />
                                    <TextBlock Text="取消本次登录"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Launcher self-update -->
            <Grid x:Name="LauncherUpdateOverlay"
                  Grid.ColumnSpan="3"
                  Grid.RowSpan="2"
                  Panel.ZIndex="50"
                  Background="{DynamicResource OverlayBrush}"
                  FocusManager.IsFocusScope="True"
                  FocusManager.FocusedElement="{Binding ElementName=InstallLauncherUpdateButton}"
                  KeyboardNavigation.TabNavigation="Cycle"
                  Visibility="{Binding IsLauncherUpdateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border x:Name="LauncherUpdateDialog"
                        Width="560"
                        MaxHeight="540"
                        Margin="24"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HechaoRedSoftBrush}"
                                    BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <controls:IconParkIcon Kind="Download"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{DynamicResource HechaoRedDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding LauncherUpdateTitle}"
                                           FontSize="20"
                                           FontWeight="Black" />
                                <TextBlock Text="{Binding LauncherUpdateSummary}"
                                           Margin="0,5,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Padding="9,5"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HechaoRedSoftBrush}"
                                    BorderBrush="{DynamicResource HechaoRedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding IsLauncherUpdateRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="必须更新"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource HechaoRedDarkBrush}" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,22,0,18"
                                Background="{DynamicResource BorderBrush}" />

                        <Border Grid.Row="2"
                                Padding="16,14"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer MaxHeight="116"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding LauncherUpdateReleaseNotes}"
                                               FontSize="13"
                                               LineHeight="21"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding LauncherUpdateSizeText, StringFormat=安装包大小：{0}}"
                                           Margin="0,11,0,0"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}" />
                            </Grid>
                        </Border>

                        <controls:LiveRegionBorder x:Name="LauncherUpdateProgressRegion"
                                                   Grid.Row="3"
                                                   Margin="0,20,0,0"
                                                   Focusable="True"
                                                   AutomationProperties.Name="启动器更新状态"
                                                   AutomationProperties.ItemStatus="{Binding LauncherUpdateStatus}"
                                                   AutomationProperties.LiveSetting="Polite">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:AnimatedProgressBar Grid.Row="0"
                                                              Style="{StaticResource HechaoProgressBarStyle}"
                                                              Maximum="100"
                                                              Value="{Binding LauncherUpdateProgress, Mode=OneWay}"
                                                              AutomationProperties.Name="启动器更新进度" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding LauncherUpdateStatus}"
                                           Margin="0,9,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </Grid>
                        </controls:LiveRegionBorder>

                        <Grid Grid.Row="4"
                              Margin="0,24,0,0"
                              HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Height="44"
                                    MinHeight="44"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Content="稍后更新"
                                    Command="{Binding DismissLauncherUpdateCommand}" />
                            <Button x:Name="InstallLauncherUpdateButton"
                                    Grid.Column="2"
                                    Height="44"
                                    MinHeight="44"
                                    Padding="18,10"
                                    Foreground="White"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallLauncherUpdateCommand}"
                                    AutomationProperties.Name="下载更新并重启">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <controls:IconParkIcon Kind="Download"
                                                           Width="15"
                                                           Height="15"
                                                           Margin="0,0,8,0"
                                                           Foreground="White" />
                                    <TextBlock Text="下载并重启"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Toast -->
            <controls:LiveRegionBorder x:Name="ToastLiveRegion"
                    Grid.Column="2"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Padding="17,10"
                    Panel.ZIndex="30"
                    Background="{DynamicResource ToastBrush}"
                    CornerRadius="5"
                    Tag="{Binding ToastSeverity}"
                    AutomationProperties.Name="{Binding ToastMessage}"
                    AutomationProperties.ItemStatus="{Binding ToastAutomationStatus}"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconParkIcon Kind="{Binding ToastIconKind}"
                                           Width="12"
                                           Height="12"
                                           Foreground="{DynamicResource ToastIconBrush}"
                                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ToastMessage}"
                               Margin="8,0,0,0"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center" />
                </Grid>
            </controls:LiveRegionBorder>
        </Grid>
    </Border>
</Window>
