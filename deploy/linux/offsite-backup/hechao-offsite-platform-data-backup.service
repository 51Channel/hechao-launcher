[Unit]
Description=Encrypt and copy Hechao forum and Sub2API data to private OSS
Wants=network-online.target docker.service
After=network-online.target docker.service hechao.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hechao-offsite-backup/environment
Environment=HECHAO_BACKUP_OSS_BUCKET=hechaoworld
Environment=HECHAO_BACKUP_OSS_REGION=cn-shanghai
Environment=HECHAO_BACKUP_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
ExecStart=/usr/local/sbin/hechao-offsite-platform-data-backup
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/hechao-platform-data
ReadWritePaths=/var/lib/hechao-offsite-platform-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
